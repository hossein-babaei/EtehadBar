@model Definition
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["pageId"] = 2;
    var data = ViewBag.data as IPagedList<Definition>;
    ViewData["Title"] = "تعاریف";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
    {
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
    }
}
@section Scripts{
    <script>
        function create() {
            preloader();
            $.get('@Url.Action("CreateDefinition")', { }, function (r) {
                $('#create-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#create-modal form');
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditDefinition")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a onclick="create()" class="uk-button uk-button-primary">افزودن</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.DefinitionType)</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    string type = item.DefinitionType switch
                    {
                        DefinitionType.Car => "خودرو",
                        DefinitionType.BillType => "نوع هزینه",
                        DefinitionType.BankBranch => "نام بانک",
                        _ => ""
                    };

                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>@type</td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("Definition", new { p = page }))
        </div>
    }
</div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteDefinition" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>