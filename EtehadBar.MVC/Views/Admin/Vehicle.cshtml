@model Vehicle
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["pageId"] = 6;
    var data = ViewBag.data as IPagedList<Vehicle>;
    ViewData["Title"] = "خودرو ها";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
    {
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
    }
}
@section Scripts{
    <script>
        $('#search-modal form').submit(function (e) {
            e.preventDefault();
            filter();
        });
        function filter() {
            var data = $('#search-modal form').serialize();
            if ($('#search-modal #param').val() != '' && $('#search-modal #param').val() != ' ') {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("SearchVehicle")',
                    data: data,
                    dataType: 'html',
                    beforeSend: function () {
                        preloader();
                    },
                    success: function (r) {
                        $('#append').html(r);
                    },
                    error: function (e) {
                        uiAlert(e.responseText, 'danger')
                    },
                    complete: function () {
                        preloader();
                        UIkit.modal('#search-modal').hide();
                    }
                });
            } else {
                uiAlert('لطفا نام یا نام خانوادگی را وارد نمایید.', 'danger');
            }
        }
        function create() {
            preloader();
            $.get('@Url.Action("CreateVehicle")', {}, function (r) {
                $('#create-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#create-modal form');
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditVehicle")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a onclick="create()" class="uk-button uk-button-primary">افزودن</a>
        <button uk-toggle="#search-modal" class="uk-button uk-button-secondary uk-margin-small-right">جستجو</button>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Type)</th>
                    <th>شماره خودرو</th>
                    <th>@Html.DisplayNameFor(model => model.VehicleOwnerFullname)</th>
                    <th>@Html.DisplayNameFor(model => model.NationalNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Phonenumber)</th>
                    <th>@Html.DisplayNameFor(model => model.VehicleCardNo)</th>
                    <th>@Html.DisplayNameFor(model => model.DriverCardNo)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    @if (!User.IsInRole("RegisterUser"))
                    {
                        <th width="50">حساب ها</th>
                        <th width="50">ویرایش</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.Type)</td>
                        <td class="uk-text-bold">ایران @item.IranStateNumber - @item.RightNumber @item.NumberWord @item.LeftNumber</td>
                        <td>@Html.DisplayFor(modelItem => item.VehicleOwnerFullname)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.NationalNumber) ? "---" : item.NationalNumber)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Phonenumber) ? "---" : item.Phonenumber)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.VehicleCardNo) ? "---" : item.VehicleCardNo)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.DriverCardNo) ? "---" : item.DriverCardNo)</td>
                        @if (item.Status)
                        {
                            <td class="uk-text-success">فعال</td>
                        }
                        else
                        {
                            <td class="uk-text-danger">غیر فعال</td>
                        }
                        @if (!User.IsInRole("RegisterUser"))
                        {
                            <td><a class="uk-button uk-button-primary uk-button-small" asp-action="VehicleBankAccount" asp-route-id="@item.Id"><i class="fas fa-money-check-alt"></i></a></td>
                            <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit('@item.Id')"><i class="far fa-edit"></i></a></td>
                        }
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        var type = (bool)ViewData["Type"];
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @if (type) 
                @Html.PagedListPager(data, page => Url.Action("Vehicle", new { p = page }))
            else
                @Html.PagedListPager(data, page => Url.Action("Vehicle", new { p = page, type = type }))
        </div>
    }
</div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجوی خودرو</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <div>
                    <label class="uk-form-label">نام مالک یا 3 رقم سمت راست پلاک را وارد کنید</label>
                    <input class="uk-input uk-border-rounded" id="param" name="param" autocomplete="off" placeholder="در این قسمت تایپ نمائید..." />
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="Vehicle" asp-controller="Admin" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
