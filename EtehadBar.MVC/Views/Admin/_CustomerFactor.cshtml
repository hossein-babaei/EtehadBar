@model CustomerFactor
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var data = ViewBag.data as IPagedList<CustomerFactor>;
    int i = 1;
    if (data.PageNumber > 1)
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
}

<div class="uk-overflow-auto">
    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>@Html.DisplayNameFor(model => model.FactorNumber)</th>
                <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                <th>@Html.DisplayNameFor(model => model.CalendarId)</th>
                <th>@Html.DisplayNameFor(model => model.Date)</th>
                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                <th width="50">ویرایش</th>
                <th width="50">حذف</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in data)
            {
                var pd = new PersianDateTime(item.Date);
                <tr class="uk-text-center sm">
                    <td>@i</td>
                    <td>@item.FactorNumber</td>
                    <td>@item.Customer.Name</td>
                    <td>@item.Calendar.Title</td>
                    <td>@pd.ToString("yyyy/MM/dd")</td>
                    <td>@item.Amount.ToString("N0")</td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.RowId')"><i class="fas fa-trash-alt"></i></a></td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
@if (data.PageCount > 1)
{
    if (ViewBag.customerId is not null)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("CustomerFactor_Search", new { p = page, customerId = ViewBag.customerId, calendarId = ViewBag.calendarId }), X.PagedList.Mvc.Core.Common.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(new AjaxOptions() { HttpMethod = "POST", UpdateTargetId = "append", LoadingElementId = "preloader", OnSuccess = "goUp" }))
        </div>
    }
    else
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("CustomerFactorPartial", new { p = page }), X.PagedList.Mvc.Core.Common.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(new AjaxOptions() { HttpMethod = "POST", UpdateTargetId = "append", LoadingElementId = "preloader", OnSuccess = "goUp" }))
        </div>
    }

}