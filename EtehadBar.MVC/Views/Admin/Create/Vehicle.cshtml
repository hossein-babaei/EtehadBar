@model Vehicle
@{
    var types = (List<Definition>)ViewData["Definition"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">افزودن جدید</h2>
    </div>
    <div class="uk-modal-body">
        <form id="create-form" asp-action="CreateVehicle" method="post">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="Type" class="uk-form-label"></label>
                    <select asp-for="Type" class="uk-select uk-border-rounded">
                        @foreach (var item in types)
                        {
                            <option value="@item.Title">@item.Title</option>
                        }
                    </select>
                    <span asp-validation-for="Type" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Number" class="uk-form-label"></label>
                    <input asp-for="Number" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Number" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Status" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="Status" value="true" checked /> فعال</label>
                        <label><input class="uk-radio" type="radio" name="Status" value="false" /> غیر فعال</label>
                    </div>
                    <span asp-validation-for="Status" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="$('#create-form').submit()">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>