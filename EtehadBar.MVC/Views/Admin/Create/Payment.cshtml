@model Payment
@{
    var userInfo = (ApplicationUser)ViewData["UserInfo"];
    string role = userInfo.Role switch
    {
        (byte)ApplicationRoles.Admin => "مدیر سیستم",
        (byte)ApplicationRoles.User => "کاربر سیستم",
        (byte)ApplicationRoles.Driver => "راننده",
        _ => ""
    };
    var calendar = (List<Calendar>)ViewData["Calendar"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">حقوق / مساعده</h2>
    </div>
    <div class="uk-modal-body">
        <div class="uk-grid-divider uk-margin-bottom uk-child-width-auto uk-text-center uk-flex uk-flex-center" uk-grid>
            <div>
                @if (string.IsNullOrEmpty(userInfo.Avatar))
                {
                    <span class="xs">بدون تصویر پرسنلی</span>
                }
                else
                {
                    <div uk-lightbox>
                        <a class="uk-button uk-button-default" href="/img/user/@userInfo.Avatar" data-caption="@userInfo.Firstname @userInfo.Lastname (@role)">
                            <img class="uk-box-shadow-small uk-border-rounded" width="70" src="~/img/user/@userInfo.Avatar" />
                        </a>
                    </div>
                }
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-margin-bottom-small sm">نام و نام خانوادگی</p>
                <span class="md">@userInfo.Firstname @userInfo.Lastname</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-margin-bottom-small sm">نقش</p>
                <span class="md">@role</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-margin-bottom-small sm">کد ملی</p>
                <span class="md">@userInfo.NationalId</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-margin-bottom-small sm">شماره تلفن همراه</p>
                <span class="md">@userInfo.PhoneNumber</span>
            </div>
        </div>
        <form id="create-form" asp-action="CreatePayment" method="post" enctype="multipart/form-data">
            <input asp-for="AdminId" type="hidden" value="@ViewData["AdminId"].ToString()" />
            <input asp-for="ApplicationUserId" type="hidden" value="@userInfo.Id" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="CalendarId" class="uk-form-label"></label>
                    <select asp-for="CalendarId" class="uk-select uk-border-rounded">
                        @foreach (var item in calendar)
                        {
                            <option value="@item.Id">@item.Title</option>
                        }
                    </select>
                    <span asp-validation-for="CalendarId" class="uk-text-danger"></span>
                </div>
                @{
                    var now = PersianDateTime.Now;
                }
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">روز</label>
                    <select class="uk-select uk-border-rounded" name="day" dir="ltr">
                        @for (int i = 1; i < 32; i++)
                        {
                            <!option value="@i" @if (now.Day == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">ماه</label>
                    <select class="uk-select uk-border-rounded" name="month" dir="ltr">
                        @for (int i = 1; i < 13; i++)
                        {
                            <!option value="@i" @if (now.Month == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">سال</label>
                    <input class="uk-input uk-border-rounded" name="year" value="@ViewData["Year"].ToString()" dir="ltr" readonly />
                </div>
                <div>
                    <label asp-for="Amount" class="uk-form-label"></label>
                    <input asp-for="Amount" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Amount" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Description" class="uk-form-label"></label>
                    <textarea asp-for="Description" class="uk-textarea uk-border-rounded" rows="2"></textarea>
                    <span asp-validation-for="Description" class="uk-text-danger"></span>
                </div>
                <div class="uk-text-center">
                    <div class="uk-margin-top">
                        <div><label class="uk-form-label">تصویر رسید یا سند مالی</label></div>
                        <div uk-form-custom="target: true">
                            <a class="uk-form-icon uk-form-icon-flip" href="" uk-icon="icon: image"></a>
                            <input name="pic" accept=".jpg,.png" type="file" id="pic" />
                            <input class="uk-input uk-form-width-large uk-form-small" type="text" placeholder="انتخاب کنید ..." disabled>
                        </div>
                    </div>
                </div>
                <div>
                    <label asp-for="Type" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="Type" value="@((byte)PaymentType.Salary)" checked /> حقوق</label>
                        <label><input class="uk-radio" type="radio" name="Type" value="@((byte)PaymentType.AdvanceMoney)" /> مساعده</label>
                    </div>
                    <span asp-validation-for="Type" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="$('#create-form').submit()">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>