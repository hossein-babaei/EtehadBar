@model CreateAccountBookVM
@{
    var customers = (List<Customer>)ViewData["Customers"];
    var calendars = (List<Calendar>)ViewData["Calendars"];
}

<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">افزودن جدید</h2>
    </div>
    <div class="uk-modal-body">
        <form id="create-form" asp-action="CreateAccountBook" method="post">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="CustomerId" class="uk-form-label"></label>
                    <select asp-for="CustomerId" class="uk-select uk-border-rounded">
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="CalendarId" class="uk-form-label"></label>
                    <select asp-for="CalendarId" class="uk-select uk-border-rounded">
                        @foreach (var calendar in calendars)
                        {
                            <option value="@calendar.Id">@calendar.Title</option>
                        }
                    </select>
                    <span asp-validation-for="CalendarId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Number" class="uk-form-label"></label>
                    <input asp-for="Number" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Number" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="FactorNumber" class="uk-form-label"></label>
                    <input asp-for="FactorNumber" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="FactorNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="LoadFactorLimit" class="uk-form-label"></label>
                    <input asp-for="LoadFactorLimit" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="LoadFactorLimit" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#create-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>