@model CreateUserVM
@{
    var type = "مدیر سیستم";
    if (ViewBag.type == (byte)ApplicationRoleType.User)
    {
        type = "کاربر سیستم";
    }
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">افزودن @type</h2>
    </div>
    <div class="uk-modal-body">
        <form id="create-form" asp-action="CreateUser" method="post" enctype="multipart/form-data">
            <input asp-for="Role" type="hidden" value="@ViewBag.type" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
                <div>
                    <label asp-for="Firstname" class="uk-form-label"></label>
                    <input asp-for="Firstname" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Firstname" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Lastname" class="uk-form-label"></label>
                    <input asp-for="Lastname" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Lastname" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Username" class="uk-form-label"></label>
                    <input asp-for="Username" dir="ltr" maxlength="11" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Username" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="NationalId" class="uk-form-label"></label>
                    <input asp-for="NationalId" dir="ltr" maxlength="10" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="NationalId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Password" class="uk-form-label"></label>
                    <input asp-for="Password" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Password" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="uk-form-label"></label>
                    <input asp-for="ConfirmPassword" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="ConfirmPassword" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="BirthString" class="uk-form-label"></label>
                    <input asp-for="BirthString" dir="ltr" readonly class="uk-input uk-border-rounded date-picker" />
                    <span asp-validation-for="BirthString" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Gender" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="Gender" value="true" checked /> مرد</label>
                        <label><input class="uk-radio" type="radio" name="Gender" value="false" /> زن</label>
                    </div>
                    <span asp-validation-for="Gender" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-1 uk-text-center">
                    <div class="uk-margin-top">
                        <div><label class="uk-form-label">تصویر پرسنلی (الزامی نیست)</label></div>
                        <div uk-form-custom="target: true">
                            <a class="uk-form-icon uk-form-icon-flip" href="" uk-icon="icon: image"></a>
                            <input asp-for="Pic" accept=".jpg,.png" type="file" />
                            <input class="uk-input uk-form-width-large uk-form-small" type="text" placeholder="انتخاب کنید ..." disabled>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#create-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>