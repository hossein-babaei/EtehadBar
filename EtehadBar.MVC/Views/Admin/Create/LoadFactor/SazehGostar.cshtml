@model CSazehGostarLoadFactorVM
@{
    var fees = (List<ShippingFee>)ViewData["Fees"];
    var contract = (List<Contract>)ViewData["Contracts"];
    var drivers = (List<Driver>)ViewData["Drivers"];
    var vehicles = (List<Vehicle>)ViewData["Vehicles"];
    var calendars = (List<Calendar>)ViewData["Calendars"];
    long sequence = (long)ViewData["Sequence"];
    var accountBooks = (List<AccountBook>)ViewData["AccountBooks"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">افزودن بارنامه سازه گستر</h2>
    </div>
    <div class="uk-modal-body">
        <form id="create-form">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
                <div class="uk-width-1-5@m">
                    <label asp-for="Sequence" class="uk-form-label"></label>
                    <input asp-for="Sequence" type="number" value="@sequence" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="Sequence" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-5@m">
                    <label asp-for="AccountBookId" class="uk-form-label"></label>
                    <select asp-for="AccountBookId" class="uk-select uk-border-rounded uk-form-small">
                        @foreach (var accountBook in accountBooks)
                        {
                            <option value="@accountBook.Id">@accountBook.Number (@(accountBook.IsOpen ? "باز" : "بسته"))</option>
                        }
                    </select>
                    <span asp-validation-for="AccountBookId" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-3-5@m">
                    <label asp-for="ContractId" class="uk-form-label"></label>
                    <select asp-for="ContractId" onchange="getShippingFees(this)" class="uk-select uk-border-rounded">
                        @foreach (var item in contract)
                        {
                            <option value="@item.Id">@item.Subject - @item.Number</option>
                        }
                    </select>
                    <span asp-validation-for="ContractId" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-1@m">
                    <label asp-for="ShippingFeeId" class="uk-form-label"></label>
                    <select asp-for="ShippingFeeId" class="uk-select uk-border-rounded" data-last-type="@fees.First().ShippingFeeType" onchange="loadFactorFormShippingFeeChangeHandler(this, '@CustomerType.SazehGostar')">
                        @foreach (var item in fees)
                        {
                            <!option value="@item.Id" data-vehicle-type="@item.Vehicle" data-type="@item.ShippingFeeType" @if(item == fees.First()){ <text>selected="selected"</text> }>@(string.IsNullOrWhiteSpace(item.Title) ? "" : $"({item.Title}) ")@item.Vehicle - (@item.Origin.Title به @item.Destination.Title - @item.ShippingFeeLoadType.Name) - @(item.ShippingFeeType == ShippingFeeType.Normal ? item.Price.ToString("N0") : "نرخ آزاد")</!option>
                        }
                    </select>
                    <span asp-validation-for="ShippingFeeId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="VehicleId" class="uk-form-label"></label>
                    <select asp-for="VehicleId" class="uk-select uk-border-rounded">
                        @foreach (var item in vehicles)
                        {
                            <option value="@item.Id" data-vehicle-type="@item.Type">@item.Type | ایران @item.IranStateNumber - @item.RightNumber @item.NumberWord @item.LeftNumber</option>
                        }
                    </select>
                    <span asp-validation-for="VehicleId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DriverId" class="uk-form-label"></label>
                    <select asp-for="DriverId" class="uk-select uk-border-rounded">
                        @foreach (var item in drivers)
                        {
                            <option value="@item.Id">@item.Fullname (@item.NationalNumber)</option>
                        }
                    </select>
                    <span asp-validation-for="DriverId" class="uk-text-danger"></span>
                </div>
                @{
                    var now = PersianDateTime.Now;
                }
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">روز</label>
                    <select asp-for="Day" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                        @for (int i = 1; i < 32; i++)
                        {
                            <!option value="@i" @if (now.Day == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">ماه</label>
                    <select asp-for="Month" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                        @for (int i = 1; i < 13; i++)
                        {
                            <!option value="@i" @if (now.Month == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">سال</label>
                    <input class="uk-input uk-border-rounded uk-form-small" asp-for="Year" value="@ViewData["Year"].ToString()" dir="ltr" readonly />
                </div>
                <div>
                    <label asp-for="CalendarId" class="uk-form-label"></label>
                    <select asp-for="CalendarId" class="uk-select uk-border-rounded uk-form-small">
                        @foreach (var item in calendars)
                        {
                            <option value="@item.Id">@item.Title - (@(new PersianDateTime(item.StartDate).ToString("yyyy/MM/dd")) الی @(new PersianDateTime(item.EndDate).ToString("yyyy/MM/dd")))</option>
                        }
                    </select>
                    <span asp-validation-for="CalendarId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="ExitNumber" class="uk-form-label"></label>
                    <input asp-for="ExitNumber" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="ExitNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="LoadNumber" class="uk-form-label"></label>
                    <input asp-for="LoadNumber" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="LoadNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="RegisterCode" class="uk-form-label"></label>
                    <input asp-for="RegisterCode" dir="ltr" class="uk-input uk-border-rounded uk-form-small" value="635" readonly />
                    <span asp-validation-for="RegisterCode" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Certain" class="uk-form-label"></label>
                    <input asp-for="Certain" dir="ltr" class="uk-input uk-border-rounded uk-form-small" value="8114" readonly />
                    <span asp-validation-for="Certain" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Nature" class="uk-form-label"></label>
                    <input asp-for="Nature" dir="ltr" class="uk-input uk-border-rounded uk-form-small" value="1" readonly />
                    <span asp-validation-for="Nature" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-3@m">
                    <label asp-for="DetailedCostCenter" class="uk-form-label"></label>
                    <input asp-for="DetailedCostCenter" class="uk-input uk-border-rounded uk-form-small" value="800720" readonly />
                    <span asp-validation-for="DetailedCostCenter" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-3@m">
                    <label asp-for="Count" class="uk-form-label"></label>
                    <input asp-for="Count" dir="ltr" class="uk-input uk-border-rounded uk-form-small" value="1" readonly />
                    <span asp-validation-for="Count" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-3@m">
                    <label asp-for="SazehLoadType" class="uk-form-label"></label>
                    <select asp-for="SazehLoadType" class="uk-select uk-border-rounded uk-form-small">
                        <option value="@((int)SazehGostarLoadType.OneWay)">رفت</option>
                        <option value="@((int)SazehGostarLoadType.TwoWay)">رفت و برگشت</option>
                    </select>
                    <span asp-validation-for="SazehLoadType" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitCreate(@((byte)CustomerType.SazehGostar))">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>