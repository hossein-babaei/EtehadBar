@model LoadFactor
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var customers = (List<Customer>)ViewData["Customer"];
    ViewData["pageId"] = 8;
    var data = ViewBag.data as IPagedList<LoadFactor>;
    ViewData["Title"] = "بارنامه ها";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
    {
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
    }
}
@section Links{
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script>
        $('#search-modal form').submit(function (e) {
            e.preventDefault();
            filter();
        });
        function filter() {
            var data = $('#search-modal form').serialize();
            if ($('#search-modal #param').val() != '' && $('#search-modal #param').val() != ' ') {
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("SearchLoadFactor")',
                    data: data,
                    dataType: 'html',
                    beforeSend: function () {
                        preloader();
                    },
                    success: function (r) {
                        $('#append').html(r);
                        $('#total-count').html('(' + $('input[name="count"]').val() + ')');
                    },
                    error: function (e) {
                        uiAlert(e.responseText, 'danger')
                    },
                    complete: function () {
                        preloader();
                        UIkit.modal('#search-modal').hide();
                    }
                });
            } else {
                uiAlert('لطفا مقدار مورد نظر را وارد نمایید.', 'danger');
            }
        }
        function viewDetail(id) {
            preloader();
            $.get('@Url.Action("LoadFactorDetail")', { 'id': id }, function (r) {
                $('#create-modal').html(r);
            }, 'html').then(function () {
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function getShippingFees(t) {
            var form = $(t).parents('form');
            preloader();
            $.post('@Url.Action("GetShippingFeeJson")', { 'contractId': $(t).val() }, function (r) {
                console.log(r);
                form.find('#ShippingFeeId').html('');
                $.each(r, function (i, v) {
                    form.find('#ShippingFeeId').append(`<option value="${v.id}">${v.title != '' ? v.title : ''} ${v.vehicle} (${v.origin} به ${v.destination} - ${v.loadType}) ${v.price}</option>`);
                });
            }, 'json').then(function () {
                parseValidator(form);
                preloader();
            });
        }
        function getCreateForm(id, type) {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("CreateLoadFactor")',
                data: { 'customerId': id, 'customerType': type },
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#create-modal').html(r);
                    $('#create-modal #AccountBookId').select2({ width: '100%' });
                    $('#create-modal #ContractId').select2({ width: '100%' });
                    $('#create-modal #ShippingFeeId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                    $('#create-modal #VehicleId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                    $('#create-modal #DriverId').select2({ width: '100%' });
                    parseValidator('#create-modal form');
                    UIkit.modal('#create-modal').show();
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function submitCreate(type) {
            if ($('#create-modal form').valid() == true) {
                var url = '';
                if (type == @((byte)CustomerType.SaipaPlasco)) {
                    url = '@Url.Action("CreateSaipaPlascoLoadFactor")';
                } else if (type == @((byte)CustomerType.SaipaPress)) {
                    url = '@Url.Action("CreateSaipaPressLoadFactor")';
                } else if (type == @((byte)CustomerType.SazehGostar)) {
                    url = '@Url.Action("CreateSazehGostarLoadFactor")';
                } else {
                    url = '@Url.Action("CreateMehrcomParsLoadFactor")';
                }
                $.ajax({
                    type: 'POST',
                    url: url,
                    data: $('#create-modal form').serialize(),
                    dataType: 'json',
                    beforeSend: function () {
                        preloader();
                    },
                    success: function (r) {
                        uiAlert(r.msg, r.status);
                        if (r.status == 'success') {
                            $.get('@Url.Action("LoadFactorPartial")', {}, function (r) {
                                $('#append').html(r);
                            }, 'html');

                            $('#create-modal #Sequence').val(r.sequence);
                        }
                    },
                    error: function (e) {
                        uiAlert(e.responseText, 'danger');
                    },
                    complete: function () {
                        preloader();
                    }
                });
            }
        }
        function getEditForm(id) {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("EditLoadFactor")',
                data: { 'loadFactorId': id },
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#edit-modal').html(r);
                    $('#edit-modal #AccountBookId').select2({ width: '100%' });
                    $('#edit-modal #ContractId').select2({ width: '100%' });
                    $('#edit-modal #ShippingFeeId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                    $('#edit-modal #VehicleId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                    $('#edit-modal #DriverId').select2({ width: '100%' });
                    parseValidator('#edit-modal form');
                    UIkit.modal('#edit-modal').show();
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
        function loadFactorFormShippingFeeChangeHandler(select, customerType) {
            let lastType = $(select).data('last-type'),
                type = $(select).find('option:selected').data('type');
            if (type == '@ShippingFeeType.Normal' && lastType != '@ShippingFeeType.Normal') {
                $(select).parent().next().remove();
                $(select).parent().next().remove();
                if (customerType == '@CustomerType.SaipaPress' || customerType == '@CustomerType.MehrcomPars') {
                    $(select).parent().next().remove();
                    $(select).parent().next().remove();
                }
            } else if (type == '@ShippingFeeType.Custom' && lastType != '@ShippingFeeType.Custom') {
                $(`<div class="uk-grid-margin uk-first-column">
                                        <label class="uk-form-label" for="Amount">مبلغ (دریافتی)</label>
                                                <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" data-val-required="پر کردن این فیلد الزامی است." id="Amount" name="Amount" value="">
                                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="Amount" data-valmsg-replace="true"></span>
                                    </div>
                                    <div class="uk-grid-margin uk-first-column">
                                        <label class="uk-form-label" for="DriverFee">کرایه راننده (ریال)</label>
                                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" data-val-required="پر کردن این فیلد الزامی است." id="DriverFee" name="DriverFee" value="">
                                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="DriverFee" data-valmsg-replace="true"></span>
                                    </div>
                                    ${(customerType == '@CustomerType.SaipaPress' || customerType == '@CustomerType.MehrcomPars') ?
                        `<div class="uk-grid-margin uk-first-column">
                                        <label class="uk-form-label" for="TonnagePrice">نرخ تناژ اضافه (ریال)</label>
                                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" id="TonnagePrice" name="TonnagePrice" value="">
                                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="TonnagePrice" data-valmsg-replace="true"></span>
                                    </div>
                                    <div class="uk-grid-margin uk-first-column">
                                        <label class="uk-form-label" for="DriverTonnagePrice">نرخ تناژ اضافه راننده (ریال)</label>
                                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" id="DriverTonnagePrice" name="DriverTonnagePrice" value="">
                                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="DriverTonnagePrice" data-valmsg-replace="true"></span>
                                    </div>` : ''}`).insertAfter($(select).parent());
            }

            $(select).parents('form').data('validator', null);
            $.validator.unobtrusive.parse($(select).parents('form'));

            $(select).data('last-type', type);
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"] <span id="total-count">(@data.TotalItemCount)</span></span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a uk-toggle="#customer-modal" class="uk-button uk-button-primary">افزودن</a>
        <button uk-toggle="#search-modal" class="uk-button uk-button-secondary uk-margin-small-right">جستجو</button>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.LoadNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.LoadNumberGov)</th>
                    <th>@Html.DisplayNameFor(model => model.Date)</th>
                    <th>مشتری</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>@Html.DisplayNameFor(model => model.Amount)</th>
                        <th>@Html.DisplayNameFor(model => model.DriverFee)</th>
                    }
                    else
                    {
                        <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    }
                    <th width="50">جزئیات</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr class="uk-text-center sm">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.LoadNumber)</td>
                        @if (string.IsNullOrWhiteSpace(item.LoadNumberGov))
                        {
                            <td>---</td>
                        }
                        else
                        {
                            <td>@Html.DisplayFor(modelItem => item.LoadNumberGov)</td>
                        }
                        <td>@(new PersianDateTime(item.Date).ToString("yyyy/MM/dd"))</td>
                        <td>@item.Contract.Customer.Name</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td class="uk-text-bold md">@item.Amount.ToString("N0")</td>
                            <td class="uk-text-bold md">@item.DriverFee.ToString("N0")</td>
                        }
                        else
                        {
                            <td class="uk-text-bold md">@item.Amount.ToString("N0")</td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="viewDetail('@item.Id')"><i class="far fa-eye"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="getEditForm('@item.Id')"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.Id')"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("LoadFactor", new { p = page }))
        </div>
    }
</div>
<div id="edit-modal" class="uk-modal-container" uk-modal="bg-close: false"></div>
<div id="create-modal" class="uk-modal-container" uk-modal="bg-close: false"></div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجوی بارنامه</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <div>
                    <label class="uk-form-label">شماره بارنامه</label>
                    <input class="uk-input uk-border-rounded" id="param" name="param" autocomplete="off" placeholder="در این قسمت تایپ نمائید..." />
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="LoadFactor" asp-controller="Admin" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteLoadFactor" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>
<div id="customer-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>افزودن بارنامه برای</h3>
        <ul class="uk-list">
            @foreach (var item in customers)
            {
                <li>
                    <button class="uk-button uk-button-primary uk-border-rounded" onclick="getCreateForm(@item.Id, @((int)item.CustomerType))">@item.Name</button>
                </li>
            }
        </ul>
    </div>
</div>