    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"] <span id="total-count">(@data.TotalItemCount)</span></span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a uk-toggle="#customer-modal" class="uk-button uk-button-primary">افزودن</a>
        <button onclick="getSearchModal()" class="uk-button uk-button-secondary uk-margin-small-right">جستجو</button>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.LoadNumber)</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                    {
                        <th>@Html.DisplayNameFor(model => model.LoadNumberGov)</th>
                    }
                    <th>مسیر</th>
                    <th>خودرو</th>
                    <th>راننده</th>
                    <th>@Html.DisplayNameFor(model => model.Date)</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                    {
                        <th>مشتری</th>
                        <th>@Html.DisplayNameFor(model => model.Amount)</th>
                        <th>@Html.DisplayNameFor(model => model.DriverFee)</th>
                        <th>تغییر نرخ</th>
                    }
                    else if (User.IsInRole("User"))
                    {
                        <th>@Html.DisplayNameFor(model => model.DriverFee)</th>
                    }
                    else
                    {
                        <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    }
                    <th>موردی</th>
                    <th width="50">جزئیات</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr class="uk-text-center sm" data-id="@item.Id">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.LoadNumber)</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                        {
                            <td>@(string.IsNullOrWhiteSpace(item.LoadNumberGov) ? "---" : item.LoadNumberGov)</td>
                        }
                        <td>@item.Origin.Title<br />@item.Destination.Title</td>
                        <td>@item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                        <td>@item.Driver.Fullname</td>
                        <td>@(new PersianDateTime(item.Date).ToString("yyyy/MM/dd"))</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                        {
                            <td>@item.Contract.Customer.Name</td>
                            <td class="uk-text-bold md amount pointer" onclick="editAmount(this)" data-val="@item.Amount">@item.Amount.ToString("N0")</td>
                            <td class="uk-text-bold md driver-fee pointer" onclick="editDriverFee(this)" 
                                data-val="@item.DriverFee" data-tonnage-val="@(item.DriverTonnagePrice.HasValue ? item.DriverTonnagePrice.Value : 0)">@item.DriverFee.ToString("N0")</td>
                            
                            @if (item.IsDriverFeeEditedByAdmin)
                            {
                                <td class="uk-text-primary">بلی</td>
                            }
                            else
                            {
                                <td class="IsDriverFeeEditedByAdmin">خیر</td>
                            }
                        }
                        else if (User.IsInRole("User"))
                        {
                            <td class="uk-text-bold md driver-fee">@item.DriverFee.ToString("N0")</td>
                        }
                        else
                        {
                            <td class="uk-text-bold md">@item.Amount.ToString("N0")</td>
                        }
                        @if (item.IsFreeDriverPrice)
                        {
                            <td class="uk-text-primary">بلی</td>
                        }
                        else
                        {
                            <td>خیر</td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="viewDetail('@item.Id')"><i class="far fa-eye"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="getEditForm('@item.Id')"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.Id')"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("LoadFactor", new { p = page }))
        </div>
    }
</div>
<div id="edit-modal" class="uk-modal-container" uk-modal="bg-close: false"></div>
<div id="create-modal" class="uk-modal-container" uk-modal="bg-close: false"></div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجوی بارنامه</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <div>
                    <label class="uk-form-label">شماره خروج</label>
                    <input dir="ltr" class="uk-input uk-border-rounded uk-text-left" id="exitNumber" name="exitNumber" autocomplete="off" placeholder="شماره خروج را در این قسمت تایپ نمائید..." />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">شماره بارنامه</label>
                    <input dir="ltr" class="uk-input uk-border-rounded uk-text-left" id="loadNumber" name="loadNumber" autocomplete="off" placeholder="شماره بارنامه را در این قسمت تایپ نمائید..." />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">شماره خودرو</label>
                    <input class="uk-input uk-border-rounded uk-text-left" id="vehicleNumber" name="vehicleNumber" autocomplete="off" placeholder="شماره خودرو را به صورت کامل همراه با فاصله ها وارد کنید..." />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">تقویم کاری</label>
                    <select class="uk-select uk-border-rounded" id="calendar" name="calendar"></select>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="uk-margin-small-top">
                        <label class="uk-form-label">بارنامه های موردی</label>
                        <label><input class="uk-radio" type="radio" id="isFreeDriverPrice" name="isFreeDriverPrice" value="true"> بلی</label>
                        <label><input class="uk-radio" type="radio" id="isFreeDriverPrice" name="isFreeDriverPrice" value="false" checked> خیر</label>
                    </div>
                }
                else
                {
                    <input id="isFreeDriverPrice" name="isFreeDriverPrice" type="hidden" />
                }
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="LoadFactor" asp-controller="Admin" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="edit-driver-fee-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="edit-driver-fee-form" method="post" asp-action="EditLoadFactorDriverFee" asp-controller="Admin" autocomplete="off">
            <h3>ویرایش کرایه راننده</h3>
            <input type="hidden" name="Id" />
            <div class="uk-grid uk-grid-medium uk-child-width-1-1" uk-grid>
                <div>
                    <label class="uk-form-label">کرایه</label>
                    <input dir="ltr" class="uk-input uk-border-rounded format-number" name="Fee" id="Fee" />
                </div>
                <div>
                    <label class="uk-form-label">اضافه تناز پرداختی</label>
                    <input dir="ltr" class="uk-input uk-border-rounded format-number" name="TonnageFee" id="TonnageFee" />
                </div>
            </div>
            <div class="uk-margin uk-grid-small uk-child-width-auto uk-grid">
                <label>بارنامه آزاد</label>
                <label><input class="uk-radio" type="radio" name="IsFree" value="true" checked> بلی</label>
                <label><input class="uk-radio" type="radio" name="IsFree" value="false"> خیر</label>
            </div>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="submitEditDriverFee()" type="button">ثبت</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
            </div>
        </form>
    </div>
</div>
<div id="edit-amount-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="edit-amount-form" method="post" asp-action="EditLoadFactorAmount" asp-controller="Admin" autocomplete="off">
            <h3>ویرایش کرایه دریافتی</h3>
            <input type="hidden" name="Id" />
            <div class="uk-grid uk-grid-medium uk-child-width-1-1" uk-grid>
                <div>
                    <label class="uk-form-label">کرایه</label>
                    <input dir="ltr" class="uk-input uk-border-rounded format-number" name="Amount" id="Fee" />
                </div>
            </div>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="submitEditAmount()" type="button">ثبت</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
            </div>
        </form>
    </div>
</div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteLoadFactor" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>
<div id="customer-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>افزودن بارنامه برای</h3>
        <ul class="uk-list">
            @foreach (var item in customers)
            {
                <li>
                    <button class="uk-button uk-button-primary uk-border-rounded" onclick="getCreateForm(@item.Id, @((int)item.CustomerType))">@item.Name</button>
                </li>
            }
        </ul>
    </div>
