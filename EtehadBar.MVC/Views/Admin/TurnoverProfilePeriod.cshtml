@model IEnumerable<TurnoverProfilePeriod>

@{
    int i = 1;
    var turnoverProfileInfo = (TurnoverProfile)ViewData["TurnoverProfileInfo"];
    ViewData["Title"] = $"خلاصه مالی دوره ای {turnoverProfileInfo.FullName}";

    if (turnoverProfileInfo.TurnoverType == TurnoverType.Partner)
    {
        ViewData["pageId"] = 33;
    }
    else
    {
        ViewData["pageId"] = 34;
    }
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Scripts{
    <script>
        function create() {
            preloader();
            $.get('@Url.Action("CreateTurnoverProfilePeriod")', { 'id': @turnoverProfileInfo.Id }, function (r) {
                $('#append-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#create-form');
                preloader();
                UIkit.modal('#append-modal').show();
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditTurnoverProfilePeriod")', { 'id': id }, function (r) {
                $('#append-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-form');
                preloader();
                UIkit.modal('#append-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a onclick="create()" class="uk-button uk-button-primary">افزودن</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                    <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                    <th width="50">گزارش</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string startDate = new PersianDateTime(item.StartDate).ToShortDateString();
                    string endDate = new PersianDateTime(item.EndDate).ToShortDateString();

                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@item.Title</td>
                        <td>@startDate</td>
                        <td>@endDate</td>
                        <td><a class="uk-button uk-button-primary uk-button-small" asp-action="CustomerBalanceByPeriod" asp-route-id="@item.Id"><i class="fas fa-clipboard-list"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit('@item.Id')"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.Id')"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
<div id="append-modal" uk-modal="bg-close: false"></div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteTurnoverProfilePeriod" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>
