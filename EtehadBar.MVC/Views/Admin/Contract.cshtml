@model Contract
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["pageId"] = 7;
    var data = ViewBag.data as IPagedList<Contract>;
    ViewData["Title"] = "مدیریت قرارداد ها";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
    {
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
    }
}
@section Links{
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/lib/select2/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tags').select2({ width: '100%' });
            $('#tags').select2({ width: '100%' });
        });
        function getContractAddons(t) {
            var form = $(t).parents('form');
            preloader();
            $.post('@Url.Action("GetContractAddonsJson")', { 'customerId': $(t).val() }, function (r) {
                form.find('#ParentContractId').html('<option value="0" selected="selected">ثبت به عنوان قرارداد جدید</option>');
                $.each(r, function (i, v) {
                    form.find('#ParentContractId').append('<option value="' + v.id + '">' + v.subject + ' (' + v.number + ')</option>');
                });
            }, 'json').then(function () {
                parseValidator(form);
                preloader();
            });
        }
        function create() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("CreateContract")',
                data: { },
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#create-modal').html(r);
                    parseValidator('#create-modal form');
                    $('#create-modal #CustomerId').select2({ width: '100%' });
                    $('#create-modal #ParentContractId').select2({ width: '100%' });
                    UIkit.modal('#create-modal').show();
                },
                error: function (e) {
                    UIkit.notification(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditContract")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                $('#edit-modal #CustomerId').select2({ width: '100%' });
                $('#edit-modal #ParentContractId').select2({ width: '100%' });
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
        function toggleAddons(t) {
            event.stopPropagation();
            $(t).find('i').toggleClass('fa-plus-circle').toggleClass('fa-minus-circle');
            $(t).parents('tr').next('.detail-row').fadeToggle(200);
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a onclick="create()" class="uk-button uk-button-primary">افزودن</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Number)</th>
                    <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                    <th>@Html.DisplayNameFor(model => model.Subject)</th>
                    <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                    <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                    <th width="50">الحاقیه</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th width="50">کرایه</th>
                    }
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data.Where(a => !a.ParentContractId.HasValue))
                {
                    var addons = item.ContractAddons;
                    var startPersianDate = new PersianDateTime(item.StartDate);
                    var endPersianDate = new PersianDateTime(item.EndDate);

                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.Number)</td>
                        <td>@Html.DisplayFor(modelItem => item.Customer.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Subject)</td>
                        <td>@startPersianDate.ToShortDateString()</td>
                        <td>@endPersianDate.ToShortDateString()</td>
                        @if (addons.Any())
                        {
                            <td><button onclick="toggleAddons(this)" class="uk-button uk-button-primary uk-button-small"><i class="fas fa-plus-circle"></i></button></td>
                        }
                        else
                        {
                            <td><button disabled class="uk-button uk-button-default uk-button-small"><i class="fas fa-plus-circle"></i></button></td>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <td><a asp-action="ShippingFee" asp-route-contractId="@item.RowId" class="uk-button uk-button-primary uk-button-small"><i class="fas fa-truck"></i></a></td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                    if (addons.Any())
                    {
                        i = 1;
                        <tr class="detail-row" style="display:none">
                            <td colspan="10">
                                <div class="uk-overflow-auto uk-border-rounded uk-box-shadow-medium">
                                    <table class="uk-table uk-table-small uk-table-striped uk-table-middle" style="background: #ccc">
                                        <thead>
                                            <tr>
                                                <th>ردیف</th>
                                                <th>@Html.DisplayNameFor(model => model.Number)</th>
                                                <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                                                <th>@Html.DisplayNameFor(model => model.Subject)</th>
                                                <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                                                <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                                                <th width="50">کرایه</th>
                                                <th width="50">ویرایش</th>
                                                <th width="50">حذف</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var addon in addons.OrderBy(a => a.StartDate))
                                            {
                                                startPersianDate = new PersianDateTime(addon.StartDate);
                                                endPersianDate = new PersianDateTime(addon.EndDate);

                                                <tr class="uk-text-center sm">
                                                    <td>@i</td>
                                                    <td>@Html.DisplayFor(modelItem => addon.Number)</td>
                                                    <td>@Html.DisplayFor(modelItem => addon.Customer.Name)</td>
                                                    <td>@Html.DisplayFor(modelItem => addon.Subject)</td>
                                                    <td>@startPersianDate.ToShortDateString()</td>
                                                    <td>@endPersianDate.ToShortDateString()</td>
                                                    <td><a asp-action="ShippingFee" asp-route-contractId="@addon.RowId" class="uk-button uk-button-primary uk-button-small"><i class="fas fa-truck"></i></a></td>
                                                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@addon.Id)"><i class="far fa-edit"></i></a></td>
                                                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@addon.Id)"><i class="fas fa-trash-alt"></i></a></td>
                                                </tr>
                                                i++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("Contract", new { p = page }))
        </div>
    }
</div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteContract" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>