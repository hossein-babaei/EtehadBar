@model Payment
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["pageId"] = 5;
    var data = ViewBag.data as IPagedList<Payment>;
    ViewData["Title"] = "حقوق و مساعده";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
    {
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
    }
}

@section Links{
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
}

@section Scripts{
    <script src="~/lib/select2/select2.min.js"></script>
    <script>
        let isSearchLoaded = false;
        function getSearch() {
            if (!isSearchLoaded) {
                preloader();
                $.get('@Url.Action("Payment_Search")', {}, function (r) {
                    let vehicleOptions = '<option value="0">همه</option>',
                        userOptions = '<option value="all">همه</option>';

                    $.each(r.vehicles, (i,v) => {
                        vehicleOptions += `<option value="${v.id}">${v.number} - ${v.owner}</option>`;
                    });
                    $.each(r.users, (i,v) => {
                        userOptions += `<option value="${v.id}">${v.name}</option>`;
                    });
                    $('#search-modal #vehicleId').html(vehicleOptions);
                    $('#search-modal #userId').html(userOptions);

                    $('#search-modal #vehicleId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                    $('#search-modal #userId').select2({
                        width: '100%',
                        matcher: ignoreSpecialCharAndWhitespaceInSelect2
                    });
                }, 'json').then(function () {
                    preloader();
                    UIkit.modal('#search-modal').show();
                });
            } else {
                UIkit.modal('#search-modal').show();
            }
        }
        function filter() {
            var data = $('#search-modal form').serialize();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Payment_Search")',
                data: data,
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger')
                },
                complete: function () {
                    preloader();
                    UIkit.modal('#search-modal').hide();
                }
            });
        }
        function getCreate(type) {
            preloader();
            if (type == 'vehicle') {
                $.get('@Url.Action("GetVehicleListPartial")', {}, function (r) {
                    $('#vehicle-list-modal #appendList').html(r);
                }, 'html').then(function () {
                    preloader();
                    UIkit.modal('#vehicle-list-modal').show();
                });
            } else {
                $.get('@Url.Action("GetUserListExceptDriversPartial")', {}, function (r) {
                    $('#user-list-modal #appendList').html(r);
                }, 'html').then(function () {
                    preloader();
                    UIkit.modal('#user-list-modal').show();
                });
            }
        }
        function find(type) {
            preloader();
            let key = $('#vehicle-list-modal #search-term').val(),
                appendArea = $('#vehicle-list-modal #appendList'),
                url = '@Url.Action("GetVehicleListPartial")',
                data = { 'rightNumber': key };

            if (type == 'user') {
                key = $('#user-list-modal #search-term').val(),
                    appendArea = $('#user-list-modal #appendList');
                url = '';
                data = { 'name': key };
            }

            $.get(url, data, function (r) {
                appendArea.html(r);
            }, 'html').then(function () {
                preloader();
            });
        }
        $('#vehicle-list-modal #find-form').submit(function (e) {
            e.preventDefault();
            find();
        });
        $('#user-list-modal #find-form').submit(function (e) {
            e.preventDefault();
            find();
        });
        function reset(type) {
            if (type == 'user')
                $('#user-list-modal #search-term').val('');
            else
                $('#vehicle-list-modal #search-term').val('');

            find(type);
        }
        function showForm(id, type) {
            preloader();
            $.get('@Url.Action("CreatePayment")', { 'itemId': id, 'type': type }, function (r) {
                $('#create-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#create-modal form');
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditPayment")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a uk-toggle="#payment-type-modal" class="uk-button uk-button-primary">افزودن</a>
        <button onclick="getSearch()" class="uk-button uk-button-secondary uk-margin-small-right">فیلتر</button>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.CalendarId)</th>
                    <th>@Html.DisplayNameFor(model => model.Date)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    <th>خودرو / کارمند</th>
                    <th>@Html.DisplayNameFor(model => model.PaymentType)</th>
                    <th>تصویر</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    var pd = new PersianDateTime(item.Date);
                    <tr class="uk-text-center sm">
                        <td>@i</td>
                        <td>@item.Calendar.Title</td>
                        <td>@pd.ToString("yyyy/MM/dd")</td>
                        <td>@item.Description</td>
                        <td>@item.Amount.ToString("N0")</td>
                        @if (item.VehicleId.HasValue)
                        {
                            <td>ایران @item.Vehicle.IranStateNumber - @item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                        }
                        else
                        {
                            <td>@item.ApplicationUser.Firstname @item.ApplicationUser.Lastname</td>
                        }
                        @if (item.PaymentType.Equals(PaymentType.AdvanceMoney))
                        {
                            <td class="uk-text-bold">مساعده</td>
                        }
                        else
                        {
                            <td class="uk-text-bold">حقوق</td>
                        }
                        @if (string.IsNullOrEmpty(item.Picture))
                        {
                            <td>بدون تصویر</td>
                        }
                        else
                        {
                            <td>
                                <div uk-lightbox>
                                    <a class="uk-button uk-button-default" href="/img/payment/@item.Picture" data-caption="@item.Description">مشاهده تصویر</a>
                                </div>
                            </td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("Payment", new { p = page }))
        </div>
    }
</div>
<div id="vehicle-list-modal" class="uk-modal-container" uk-modal="bg-close: false">
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">لیست خودرو های اتحاد بار</h2>
        </div>
        <div class="uk-modal-body">
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-1-1 uk-width-1-2@m">
                    <form id="find-form" class="uk-search uk-search-default uk-width-1-1">
                        <a onclick="find('vehicle')" class="uk-search-icon-flip" uk-search-icon></a>
                        <input id="search-term" autocomplete="off" class="uk-search-input uk-border-rounded" type="search" placeholder="جستجوی بر اساس 3 رقم سمت راست پلاک...">
                    </form>
                </div>
                <div class="uk-width-1-1 uk-width-1-2@m uk-flex uk-flex-left@m">
                    <button class="uk-button uk-button-default" onclick="reset('vehicle')">ریست</button>
                </div>
                <div class="uk-width-1-1" id="appendList"></div>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
        </div>
    </div>
</div>
<div id="user-list-modal" class="uk-modal-container" uk-modal="bg-close: false">
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">لیست کارمندان اتحاد بار</h2>
        </div>
        <div class="uk-modal-body">
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-1-1 uk-width-1-2@m">
                    <form id="find-form" class="uk-search uk-search-default uk-width-1-1">
                        <a onclick="find('user')" class="uk-search-icon-flip" uk-search-icon></a>
                        <input id="search-term" autocomplete="off" class="uk-search-input uk-border-rounded" type="search" placeholder="جستجو بر اساس نام یا نام خانوادگی...">
                    </form>
                </div>
                <div class="uk-width-1-1 uk-width-1-2@m uk-flex uk-flex-left@m">
                    <button class="uk-button uk-button-default" onclick="reset('user')">ریست</button>
                </div>
                <div class="uk-width-1-1" id="appendList"></div>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
        </div>
    </div>
</div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeletePayment" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>
<div id="payment-type-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>نوع پرداخت</h3>
        <ul class="uk-list">
            <li>
                <button class="uk-button uk-button-primary uk-border-rounded" onclick="getCreate('vehicle')">خودرو</button>
                <button class="uk-button uk-button-primary uk-border-rounded" onclick="getCreate('user')">کارمند</button>
            </li>
        </ul>
    </div>
</div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <div>
                    <label class="uk-form-label">بر اساس پرسنل</label>
                    <select class="uk-select uk-border-rounded" id="userId" name="userId"></select>
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">بر اساس خودرو</label>
                    <select class="uk-select uk-border-rounded" id="vehicleId" name="vehicleId"></select>
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">جستجو در شرح</label>
                    <input class="uk-input uk-border-rounded uk-text-left" id="description" name="description" autocomplete="off" />
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="Payment" asp-controller="Admin" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>