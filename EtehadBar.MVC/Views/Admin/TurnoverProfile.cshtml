@model IEnumerable<TurnoverProfile>

@{
    int i = 1;
    var type = (TurnoverType)ViewData["Type"];
    if (type == TurnoverType.Partner)
    {
        ViewData["Title"] = "شرکا";
        ViewData["pageId"] = 33;
    }
    else
    {
        ViewData["Title"] = "سرمایه گذار";
        ViewData["pageId"] = 34;
    }
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var model = new TurnoverProfile();
}
@section Scripts{
    <script>
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditTurnoverProfile")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a class="uk-button uk-button-primary" uk-toggle="#create-modal">افزودن</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.ProfitPercent)</th>
                    <th width="60">دوره</th>
                    <th width="60">گردش</th>
                    <th width="50">ویرایش</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="uk-text-center sm">
                        <td>@i</td>
                        <td>@item.FullName</td>
                        <td>@item.ProfitPercent</td>
                        <td><a class="uk-button uk-button-primary uk-button-small" asp-action="TurnoverProfilePeriod" asp-route-id="@item.Id"><i class="fas fa-clipboard-list"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" asp-action="Turnover" asp-route-id="@item.RowId"><i class="fas fa-money-bill"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<partial name="~/Views/Admin/Create/TurnoverProfile.cshtml" model="model" />