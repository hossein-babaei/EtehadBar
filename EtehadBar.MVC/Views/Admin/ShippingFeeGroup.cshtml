</div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <input id="contractId" name="contractId" type="hidden" value="@contractInfo.Id" />
                <div>
                    <label class="uk-form-label">بر اساس نوع خودرو</label>
                    <select class="uk-select uk-border-rounded" id="vehicleType" name="vehicleType"></select>
                </div>
                <div>
                    <label class="uk-form-label">بر اساس مبدا</label>
                    <input class="uk-input uk-border-rounded uk-form-small" id="origin" name="origin" autocomplete="off" />
                </div>
                <div>
                    <label class="uk-form-label">بر اساس مقصد</label>
                    <input class="uk-input uk-border-rounded uk-form-small" id="destination" name="destination" autocomplete="off" />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">عنوان</label>
                    <input class="uk-input uk-border-rounded uk-form-small" id="title" name="title" autocomplete="off" />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">کرایه دریافتی</label>
                    <input class="uk-input uk-border-rounded uk-form-small" id="amount" name="amount" autocomplete="off" />
                </div>
                <div class="uk-margin-small-top">
                    <label class="uk-form-label">کرایه پرداختی به راننده</label>
                    <input class="uk-input uk-border-rounded uk-form-small" id="driverFee" name="driverFee" autocomplete="off" />
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="ShippingFeeGroup" asp-controller="Admin" asp-route-contractId="@contractInfo.RowId" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="change-fee-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>تغییر قیمت بر اساس</h3>
        <ul class="uk-list">
            <li>
                <button class="uk-button uk-button-primary uk-border-rounded" uk-toggle="#do-change-driver-amount-modal">نرخ پرداختی</button>
            </li>
            <li>
                <button class="uk-button uk-button-primary uk-border-rounded" uk-toggle="#do-change-amount-modal">نرخ دریافتی</button>
            </li>
            <li>
                <button class="uk-button uk-button-primary uk-border-rounded" uk-toggle="#change-modal">تغییر نرخ درصدی</button>
            </li>
        </ul>
    </div>
</div>
<div id="do-change-amount-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-margin-auto-vertical">
        <form id="change-form" asp-action="ChangeShippingFeeGroupByAmount">
            <input type="hidden" name="contractId" value="@contractInfo.Id" />
            <input type="hidden" name="type" value="amount" />
            <h4 class="uk-text-light">تغییر نرخ دریافتی</h4>
            <ul class="uk-list uk-list-bullet uk-text-light sm">
                <li>تا پایان عملیات مرورگر خود را نبندید و از تازه سازی (رفرش) صفحه خودداری نمائید.</li>
                <li>این عملیات ممکن است بر اساس تعداد نرخ ها و بارنامه هایی را که شامل می شود، طولانی و زمان بر باشد. لطفا از داشتن اتصال اینترنت مناسب و مطمئن اطمینان حاصل نمائید.</li>
            </ul>
            <label class="uk-form-label">تغییر نرخ بارنامه های مرتبط از تاریخ</label>
            <div>
                <input id="amountDate" name="amountDate" dir="ltr" readonly class="uk-input uk-border-rounded uk-form-small date-picker" />
            </div>
            <br />
            <label class="uk-form-label">یا از تقویم کاری</label>
            <div>
                <select id="calendarId" name="calendarId" class="uk-select uk-border-rounded uk-form-small">
                    <option value="0">انتخاب نمائید</option>
                    @foreach (var item in calendars)
                    {
                        <option value="@item.Id">@item.Title</option>
                    }
                </select>
            </div>
            <br />
            <label class="uk-form-label">نرخ کرایه قدیم</label>
            <div>
                <input name="oldAmount" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
            </div>
            <br />
            <label class="uk-form-label">نرخ کرایه جدید</label>
            <div>
                <input name="newAmount" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
            </div>
        </form>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" onclick="submitChangeAmount('amount')" type="button">ثبت تغییرات</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
        </div>
    </div>
</div>
