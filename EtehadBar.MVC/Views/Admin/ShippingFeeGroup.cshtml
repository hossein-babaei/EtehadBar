            <br />
            <label class="uk-form-label">میزان تغییر نرخ کرایه راننده</label>
            <div>
                <input name="driverAmount" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
            </div>
            <label class="uk-form-label uk-margin-small-top">نوع تغییر قیمت را انتخاب کنید (عدد وارد شده در بالا مبلغ ثابت به ریال است یا درصد)</label>
