@model Payment
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var data = ViewBag.data as IPagedList<Payment>;
    int i = 1;
    if (data.PageNumber > 1)
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
}

<div class="uk-overflow-auto">
    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>@Html.DisplayNameFor(model => model.CalendarId)</th>
                <th>@Html.DisplayNameFor(model => model.Date)</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                <th>خودرو / کارمند</th>
                <th>@Html.DisplayNameFor(model => model.PaymentType)</th>
                <th>تصویر</th>
                <th width="50">ویرایش</th>
                <th width="50">حذف</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in data)
            {
                var pd = new PersianDateTime(item.Date);
                <tr class="uk-text-center sm">
                    <td>@i</td>
                    <td>@item.Calendar.Title</td>
                    <td>@pd.ToString("yyyy/MM/dd")</td>
                    <td>@item.Description</td>
                    <td>@item.Amount.ToString("N0")</td>
                    @if (item.VehicleId.HasValue)
                    {
                        <td>ایران @item.Vehicle.IranStateNumber - @item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                    }
                    else
                    {
                        <td>@item.ApplicationUser.Firstname @item.ApplicationUser.Lastname</td>
                    }
                    @if (item.PaymentType.Equals(PaymentType.AdvanceMoney))
                    {
                        <td class="uk-text-bold">مساعده</td>
                    }
                    else
                    {
                        <td class="uk-text-bold">حقوق</td>
                    }
                    @if (string.IsNullOrEmpty(item.Picture))
                    {
                        <td>بدون تصویر</td>
                    }
                    else
                    {
                        <td>
                            <div uk-lightbox>
                                <a class="uk-button uk-button-default" href="/img/payment/@item.Picture" data-caption="@item.Description">مشاهده تصویر</a>
                            </div>
                        </td>
                    }
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>

@if (data.PageCount > 1)
{
    <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
        @Html.PagedListPager(data, page => Url.Action("Payment_Search", new { p = page, description = ViewBag.description, vehicleId = ViewBag.VehicleId, userId = ViewBag.UserId }), X.PagedList.Mvc.Core.Common.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(new AjaxOptions() { HttpMethod = "POST", UpdateTargetId = "append", LoadingElementId = "preloader", OnSuccess = "goUp" }))
    </div>
}