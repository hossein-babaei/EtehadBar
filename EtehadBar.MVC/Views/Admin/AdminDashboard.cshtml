@model AdminDashboardVM

@{
    ViewData["pageId"] = 1;
    ViewData["Title"] = "داشبورد";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var dayLimitData = (int?)ViewData["DayLimit"];
    var dayLimit = dayLimitData.HasValue ? dayLimitData.Value : 1;
}

@section Links {
    <link href="~/calendar/main.css" rel="stylesheet" />
    <style>
        #box-1 .uk-tile {
            padding: 0;
            width: 210px;
            height: 210px;
            line-height: 210px
        }

        .user-avatar {
            width: 70px;
            height: 70px;
            text-align: center;
            line-height: 70px;
            color: #bbb;
            border-radius: 100%;
            overflow: hidden
        }
    </style>
}

@section Scripts {
    <script src="~/calendar/calendarobject.js"></script>
    <script src="~/calendar/app.js"></script>
    <script>
        function changeDayLimit(select) {
        preloader();
        window.location.href = `/admin/index?dayLimit=${$(select).val()}`;
        }
    </script>
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد مدیریت</a></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <div class="uk-grid-small uk-child-width-auto" uk-grid>
            <div>
                <label class="uk-form-label">فیلتر</label>
            </div>
            <div>
                <select class="uk-select uk-form-small uk-border-rounded" style="width: 50px" onchange="changeDayLimit(this)">
                    <!option value="1" @if (dayLimit == 1)
                    {
                        <text>selected="selected"</text>
                    }
                    >1</!option>
                    <!option value="3" @if (dayLimit == 3)
                    {
                        <text>selected="selected"</text>
                    }
                    >3</!option>
                    <!option value="7" @if (dayLimit == 7)
                    {
                        <text>selected="selected"</text>
                    }
                    >7</!option>
                    <!option value="14" @if (dayLimit == 14)
                    {
                        <text>selected="selected"</text>
                    }
                    >14</!option>
                    <!option value="30" @if (dayLimit == 30)
                    {
                        <text>selected="selected"</text>
                    }
                    >30</!option>
                </select>
            </div>
            <div>
                <label class="uk-form-label">روز اخیر</label>
            </div>
        </div>
    </div>
</div>

<div class="uk-grid-medium uk-child-width-1-1" uk-grid>

    @if (Model.Cheques.Any())
    {
        int i = 1;
        <div>
            <div class="box">
                <div class="uk-overflow-auto">
                    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                        <caption class="uk-text-center">چکهای در راه</caption>
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>تاریخ سررسید</th>
                                <th>مبلغ</th>
                                <th>مشتری</th>
                                <th>شماره</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cheques)
                            {
                                var pd = new PersianDateTime(item.Date);

                                <tr class="uk-text-center sm">
                                    <td>@i</td>
                                    <td>@pd.ToString("yyyy/MM/dd")</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>@item.Customer.Name</td>
                                    <td>@item.Number</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case (ChequeStatus.NotPassed):
                                                <span class="uk-text-primary">پاس نشده</span>
                                                break;
                                            case (ChequeStatus.Rejected):
                                                <span class="uk-text-danger">برگشت خورده</span>
                                                break;
                                            case (ChequeStatus.Passed):
                                                <span class="uk-text-success">پاس شده</span>
                                                break;
                                            default:
                                                <span class="uk-text-primary">پاس نشده</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                            <tr>
                                <td colspan="6">
                                    <a class="uk-button uk-button-link" asp-action="Cheque">اطلاعات بیشتر</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div>
        <div id="box-1" class="box">
            <div class="uk-grid-medium uk-child-width-1-1 uk-child-width-1-5@m" uk-grid>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-border-circle uk-flex uk-flex-middle uk-flex-center uk-text-center">
                        <div>
                            <p class="uk-h5">مبلغ دریافتی بارنامه ها</p>
                            <p class="uk-h6 uk-margin-remove">@Model.LoadFactorsAmount.ToString("N0")</p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-border-circle uk-flex uk-flex-middle uk-flex-center uk-text-center">
                        <div>
                            <p class="uk-h5">مبلغ قابل پرداخت بارنامه ها</p>
                            <p class="uk-h6 uk-margin-remove">@Model.LoadFactorsDriverFee.ToString("N0")</p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-border-circle uk-flex uk-flex-middle uk-flex-center uk-text-center">
                        <div>
                            <p class="uk-h5">تعداد بارنامه های ثبت شده</p>
                            <p class="uk-h6 uk-margin-remove">@Model.RegisteredLoadFactorCount فقره</p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-border-circle uk-flex uk-flex-middle uk-flex-center uk-text-center">
                        <div>
                            <p class="uk-h5">حقوق و مساعده</p>
                            <p class="uk-h6 uk-margin-remove">@Model.PaymentAmount.ToString("N0")</p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-border-circle uk-flex uk-flex-middle uk-flex-center uk-text-center">
                        <div>
                            <p class="uk-h5">هزینه های جاری</p>
                            <p class="uk-h6 uk-margin-remove">@Model.CostAmount.ToString("N0")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div id="box-0" class="box">
            <div class="uk-grid-medium uk-child-width-1-3" uk-grid>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-padding-small uk-border-rounded uk-text-center pointer" uk-toggle="#mellat-file">
                        <p class="uk-h5">فایل ساز بانک ملت</p>
                        <p class="uk-h6">ملت به ملت (گروهی)</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center pointer" uk-toggle="#tejarat-file">
                        <p class="uk-h5">فایل ساز بانک تجارت</p>
                        <p class="uk-h6">تجارت به تجارت (گروهی)</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center pointer" uk-toggle="#saman-file">
                        <p class="uk-h5">فایل ساز بانک سامان</p>
                        <p class="uk-h6">سامان به سامان (گروهی)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div id="box-2" class="box">
            <div class="uk-grid-medium uk-child-width-1-2 uk-child-width-1-4@m" uk-grid>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ دریافتی مهرکام</p>
                        <p class="uk-h6">@Model.MehrcomParsAmount.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ پرداختی مهرکام</p>
                        <p class="uk-h6">@Model.MehrcomParsDriverFee.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ دریافتی سازه گستر</p>
                        <p class="uk-h6">@Model.SazehGostarAmount.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ پرداختی سازه گستر</p>
                        <p class="uk-h6">@Model.SazehGostarDriverFee.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ دریافتی پلاسکو</p>
                        <p class="uk-h6">@Model.SaipaPlascoAmount.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-muted uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ پرداختی پلاسکو</p>
                        <p class="uk-h6">@Model.SaipaPlascoDriverFee.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ دریافتی پرس</p>
                        <p class="uk-h6">@Model.SaipaPressAmount.ToString("N0")</p>
                    </div>
                </div>
                <div>
                    <div class="uk-tile uk-tile-secondary uk-padding-small uk-border-rounded uk-text-center">
                        <p class="uk-h5">مبلغ پرداختی پرس</p>
                        <p class="uk-h6">@Model.SaipaPressDeriverFee.ToString("N0")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div id="box-3" class="box">
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                @foreach (var item in Model.UserActivity)
                {
                    <div>
                        <div class="box">
                            <div class="uk-grid-medium" uk-grid>
                                <div class="uk-width-auto">
                                    <div class="user-avatar uk-box-shadow-medium">
                                        @if (string.IsNullOrEmpty(item.Avatar))
                                        {
                                            <i class="fas fa-2x fa-user"></i>
                                        }
                                        else
                                        {
                                            <img src="~/img/user/@item.Avatar" width="80" />
                                        }
                                    </div>
                                </div>
                                <div class="uk-width-expand">
                                    <h3>@item.Fullname</h3>
                                    <h5 class="uk-margin-remove uk-text-light">تعداد بارنامه های ثبت شده: <b>@item.LoadFactorRegisterdCount</b> فقره</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div>
        <div class="uk-flex uk-flex-center uk-visible@m">
            <div class="calendar-container">

                <div class="calendar-wrapper">
                    <div class="calendar-base">

                        <div class="year-wrapper">
                        </div>

                        <div class="months">
                            <span class="month-hover month-letter month-letter-1" data-num="1">فروردین</span>
                            <span class="month-hover month-letter month-letter-2" data-num="2">اردیبهشت</span>
                            <span class="month-hover month-letter month-letter-3" data-num="3">خرداد</span>
                            <span class="month-hover month-letter month-letter-4" data-num="4">تیر</span>
                            <span class="month-hover month-letter month-letter-5" data-num="5">مرداد</span>
                            <span class="month-hover month-letter month-letter-6" data-num="6">شهریور</span>
                            <span class="month-hover month-letter month-letter-7" data-num="7">مهر</span>
                            <span class="month-hover month-letter month-letter-8" data-num="8">آبان</span>
                            <span class="month-hover month-letter month-letter-9" data-num="9">آذر</span>
                            <span class="month-hover month-letter month-letter-10" data-num="10">دی</span>
                            <span class="month-hover month-letter month-letter-11" data-num="11">بهمن</span>
                            <span class="month-hover month-letter month-letter-12" data-num="12">اسفند</span>
                        </div>
                        <hr class="month-line" />

                        <div class="days">
                            <ul class="weeks">
                                <li>شنبه</li>
                                <li>یکشنبه</li>
                                <li>دوشنبه</li>
                                <li>سه شنبه</li>
                                <li>چهارشنبه</li>
                                <li>پنجشنبه</li>
                                <li>جمعه</li>
                                <div class="clearfix"></div>
                            </ul>
                        </div>

                        <div class="num-dates"></div>

                    </div>

                    <div class="calendar-left active-season">

                        <div class="num-date">X</div>
                        <div class="day">X</div>



                    </div>
                </div>
                <div class="clearfix"></div>


            </div>
        </div>
    </div>
</div>

<div id="saman-file" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>دریافت فایل انتقال وجه سامان به سامان (گروهی)</h3>
        <form enctype="multipart/form-data" asp-action="SamanToSamanFile" asp-controller="BankFileCreator" method="post">
            <div class="uk-width-1-1">
                <div class="uk-alert-warning" uk-alert>
                    <h3>تـوجه</h3>
                    <p>فایل را به صورت استاندارد و بدون تغییر در نام و ردیف ستون ها انتخاب نمائید.</p>
                    <div>
                        <div uk-form-custom="target: true">
                            <a class="uk-form-icon uk-form-icon-flip" href="" uk-icon="icon: push"></a>
                            <input name="excel" accept=".xlsx" type="file" id="excel" aria-invalid="true">
                            <input class="uk-input uk-form-width-large uk-border-rounded" type="text" placeholder="انتخاب کنید ..." disabled>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary" onclick="$('#saman-file form').submit()">ارسال</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>

<div id="mellat-file" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>دریافت فایل انتقال وجه ملت به ملت (گروهی)</h3>
        <form enctype="multipart/form-data" asp-action="MellatToMellatFile" asp-controller="BankFileCreator" method="post">
            <div class="uk-width-1-1">
                <div class="uk-alert-warning" uk-alert>
                    <h3>تـوجه</h3>
                    <p>فایل را به صورت استاندارد و بدون تغییر در نام و ردیف ستون ها انتخاب نمائید.</p>
                    <div>
                        <div uk-form-custom="target: true">
                            <a class="uk-form-icon uk-form-icon-flip" href="" uk-icon="icon: push"></a>
                            <input name="excel" accept=".xlsx" type="file" id="excel" aria-invalid="true">
                            <input class="uk-input uk-form-width-large uk-border-rounded" type="text" placeholder="انتخاب کنید ..." disabled>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary" onclick="$('#mellat-file form').submit()">ارسال</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>

<div id="tejarat-file" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>دریافت فایل انتقال وجه تجارت به تجارت (گروهی)</h3>
        <form enctype="multipart/form-data" asp-action="TejaratToTejaratFile" asp-controller="BankFileCreator" method="post">
            <div class="uk-width-1-1">
                <div class="uk-alert-warning" uk-alert>
                    <h3>تـوجه</h3>
                    <p>فایل را به صورت استاندارد و بدون تغییر در نام و ردیف ستون ها انتخاب نمائید.</p>
                    <div>
                        <div uk-form-custom="target: true">
                            <a class="uk-form-icon uk-form-icon-flip" href="" uk-icon="icon: push"></a>
                            <input name="excel" accept=".xlsx" type="file" id="excel" aria-invalid="true">
                            <input class="uk-input uk-form-width-large uk-border-rounded" type="text" placeholder="انتخاب کنید ..." disabled>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary" onclick="$('#tejarat-file form').submit()">ارسال</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>