@model IEnumerable<Customer>

@{
    int i = 1;
    ViewData["pageId"] = 13;
    ViewData["Title"] = "مشتریان خدمات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var m = new Customer();
}
@section Scripts{
    <script>
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditCustomer")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        @*<a class="uk-button uk-button-primary" uk-toggle="#create-modal">افزودن</a>*@
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.ActiveBank)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th width="60">دریافتی ها</th>
                    <th width="50">ویرایش</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="uk-text-center sm">
                        <td>@i</td>
                        <td>@item.Name</td>
                        <td>@item.Definition.Title</td>
                        @if (item.Status)
                        {
                            <td class="uk-text-bold uk-text-success">فعال</td>
                        }
                        else
                        {
                            <td class="uk-text-bold uk-text-danger">غیر فعال</td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" asp-action="CustomerIncome" asp-route-id="@item.Id"><i class="fas fa-money-bill"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                        @* <td><button class="uk-button uk-button-default uk-button-small" disabled><i class="far fa-edit"></i></button></td> *@
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<partial name="~/Views/Admin/Create/Customer.cshtml" model="m" />