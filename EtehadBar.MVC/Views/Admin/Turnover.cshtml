@model Turnover
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var data = ViewBag.data as IPagedList<Turnover>;
    var profile = (TurnoverProfile)ViewData["Profile"];
    ViewData["Title"] = $"گردش {profile.FullName}";

    if (profile.TurnoverType == TurnoverType.Partner)
        ViewData["pageId"] = 33;
    else
        ViewData["pageId"] = 34;

    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
}
@section Links{
    <link href="~/lib/persian-date/persian-datepicker.min.css" rel="stylesheet" />
    <link href="~/css/autocomplete.css" rel="stylesheet" asp-asp-append-version="true" />
    <style>
        .sequence {
            cursor: grab
        }

        pre {
            font: inherit;
            padding: 0;
            border: none;
            max-width: 270px
        }
    </style>
}
@section Scripts{
    <script src="~/lib/persian-date/persian-date.min.js"></script>
    <script src="~/lib/persian-date/persian-datepicker.min.js"></script>
    <script>
        //let autoCompleteData = [];
        async function create() {
            preloader();
            //if (autoCompleteData.length == 0) {
            //    await $.get('@Url.Action("GetTurnoverFullnames")', {}, function (r) {
            //        $.each(r, (i, v) => {
            //            autoCompleteData.push(v);
            //        });
            //    }, 'json');
            //}
            await $.get('@Url.Action("CreateTurnover")', {}, function (r) {
                $('#create-modal').html(r);
                //autocomplete($('#create-modal #Fullname').get(0), autoCompleteData);
            }, 'html').then(function () {
                $('#create-form').prepend(`<input type="hidden" name="TurnoverProfileId" value="${@profile.Id}" />`);
                parseValidator('#create-form');
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function submitCreateForm() {
            let formData = new FormData();
            $.each($('#create-modal .pic'), function (i, obj) {
                $.each(obj.files, function (j, file) {
                    formData.append(`Attachment[${j}]`, file); // is the var i against the var j, because the i is incremental the j is ever 0
                });
            });
            let data = $('#create-modal form').serializeArray();
            formData.append('TurnoverProfileId', data.find(a => a.name == 'TurnoverProfileId').value);
            formData.append('Day', data.find(a => a.name == 'Day').value);
            formData.append('Month', data.find(a => a.name == 'Month').value);
            formData.append('Year', data.find(a => a.name == 'Year').value);
            formData.append('Creditor', data.find(a => a.name == 'Creditor').value);
            formData.append('Debtor', data.find(a => a.name == 'Debtor').value);
            formData.append('Description', data.find(a => a.name == 'Description').value);
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CreateTurnover")',
                data: formData,
                dataType: 'json',
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    uiAlert(r.msg, r.status);
                    if (r.status == 'success') {
                        $.post('@Url.Action("Turnover_Search")', { 'id': '@profile.RowId' }, function (r) {
                            $('#append').html(r);
                        }, 'html');
                    }
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditTurnover")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);
                //autocomplete($('#edit-form #Fullname').get(0), autoCompleteData);
            }, 'html').then(function () {
                parseValidator('#edit-form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function submitEditForm() {
            let formData = new FormData();
            $.each($('#edit-modal .pic'), function (i, obj) {
                $.each(obj.files, function (j, file) {
                    formData.append(`Attachment[${j}]`, file); // is the var i against the var j, because the i is incremental the j is ever 0
                });
            });
            let data = $('#edit-modal form').serializeArray();
            formData.append('TurnoverProfileId', data.find(a => a.name == 'TurnoverProfileId').value);
            formData.append('Id', data.find(a => a.name == 'Id').value);
            formData.append('Day', data.find(a => a.name == 'Day').value);
            formData.append('Month', data.find(a => a.name == 'Month').value);
            formData.append('Year', data.find(a => a.name == 'Year').value);
            formData.append('Year', data.find(a => a.name == 'Year').value);
            formData.append('Creditor', data.find(a => a.name == 'Creditor').value);
            formData.append('Debtor', data.find(a => a.name == 'Debtor').value);
            formData.append('Description', data.find(a => a.name == 'Description').value);
            $.ajax({
                type: 'POST',
                url: '@Url.Action("EditTurnover")',
                data: formData,
                dataType: 'json',
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    uiAlert(r.msg, r.status);
                    if (r.status == 'success') {
                        $.post('@Url.Action("Turnover_Search")', { 'id': '@profile.RowId' }, function (r) {
                            $('#append').html(r);
                        }, 'html');
                    }
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
        function showAttachment(files) {
            const modalId = '#attachment-modal';
            let template = '',
                attachments = files.split(';;');
            $.each(attachments, (i, v) => {
                template += `
                                <div>
                                    <div uk-lightbox>
                                        <a class="uk-button uk-button-default uk-border-rounded uk-button-small" href="/img/turnover/${attachments[i]}">تصویر ${i + 1}</a>
                                    </div>
                                </div>
                                `;
            })
            $(`${modalId} .uk-grid-small`).html(template);
            UIkit.modal(modalId).show();
        }
        function filter() {
            var data = $('#search-modal form').serialize();
            $.ajax({
                type: 'Post',
                url: '@Url.Action("BankAccountBook_Search")',
                data: data,
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger')
                },
                complete: function () {
                    preloader();
                    UIkit.modal('#search-modal').hide();
                }
            });
        }
    </script>
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><a asp-action="TurnoverProfile" asp-controller="Admin" asp-route-type="@((int)profile.TurnoverType)">@(profile.TurnoverType == TurnoverType.Partner ? "شرکا" : "سرمایه گذار")</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a onclick="create()" class="uk-button uk-button-primary">افزودن</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Date)</th>
                    <th>@Html.DisplayNameFor(model => model.Creditor)</th>
                    <th>@Html.DisplayNameFor(model => model.Debtor)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th width="50">تصاویر</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr id="@item.RowId" data-row="@i" class="uk-text-center">
                        <td class="sequence" draggable="true">@i</td>
                        <td>@(new PersianDateTime(item.Date).ToString("yyyy/MM/dd"))</td>
                        <td>@item.Creditor.ToString("N0")</td>
                        <td>@item.Debtor.ToString("N0")</td>
                        <td class="uk-text-small">
                            @if (string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span>---</span>
                            }
                            else
                            {
                                <pre>@Html.DisplayFor(modelItem => item.Description)</pre>
                            }
                        </td>
                        @if (string.IsNullOrEmpty(item.Attachments))
                        {
                            <td>---</td>
                        }
                        else
                        {
                            <td>
                                <a class="uk-button uk-button-primary uk-button-small"
                           onclick="showAttachment('@item.Attachments')">
                                    <i class="far fa-image"></i>
                                </a>
                            </td>
                        }
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit('@item.Id')"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.Id')"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("Turnover", new { id = profile.RowId, p = page }))
        </div>
    }
</div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="attachment-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <h3>مشاهده تصاویر ضمیمه شده</h3>
        <hr />
        <div class="uk-grid-small uk-child-width-auto uk-flex-center uk-margin-top uk-margin-bottom" uk-grid></div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteTurnover" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>