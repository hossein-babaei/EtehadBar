@model FreeLoadFactor
@{
    var adminDetail = (ApplicationUser)ViewData["Admin"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">اطلاعات بارنامه به شماره @Model.LoadNumber</h2>
    </div>
    <div class="uk-modal-body" style="background:#fff">
        <div class="uk-grid-medium uk-child-width-1-1 uk-child-width-1-2@m uk-grid-divider" uk-grid>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.LoadNumber)</p>
                <span class="sm">@Html.DisplayFor(model => model.LoadNumber)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.LoadNumberGov))
            {
                <div>
                    <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.LoadNumberGov)</p>
                    <span class="sm">@Html.DisplayFor(model => model.LoadNumberGov)</span>
                </div>
            }
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">تاریخ</p>
                <span class="sm" dir="ltr">@(new PersianDateTime(Model.Date).ToString("yyyy/MM/dd"))</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.Origin)</p>
                <span class="sm">@Html.DisplayFor(model => model.Origin)</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.Destination)</p>
                <span class="sm">@Html.DisplayFor(model => model.Destination)</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.ApplicantName)</p>
                <span class="sm">@Html.DisplayFor(model => model.ApplicantName)</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.DriverName)</p>
                <span class="sm">@Model.DriverName</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.VehicleType)</p>
                <span class="sm">@Model.VehicleType</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.VehicleNumber)</p>
                <span class="sm">@Model.VehicleNumber</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">مسئول ثبت بارنامه</p>
                <span class="sm">@adminDetail.Firstname @adminDetail.Lastname</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.CalendarId)</p>
                <span class="sm">@Model.Calendar.Title - (@(new PersianDateTime(Model.Calendar.StartDate).ToString("yyyy/MM/dd")) الی @(new PersianDateTime(Model.Calendar.EndDate).ToString("yyyy/MM/dd")))</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.Amount)</p>
                <span class="sm">@Model.Amount.ToString("N0")</span>
            </div>
            <div>
                <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.DriverFee)</p>
                <span class="sm">@Model.DriverFee.ToString("N0")</span>
            </div>
            @if (Model.Tonnage.HasValue)
            {
                <div>
                    <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.Tonnage)</p>
                    <span class="sm">@Model.Tonnage.Value.ToString("N0") تن</span>
                </div>
                <div>
                    <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.TonnagePrice)</p>
                    <span class="sm">@Model.TonnagePrice.Value.ToString("N0")</span>
                </div>
                <div>
                    <p class="uk-text-bold uk-text-secondary uk-display-inline-block xs">@Html.DisplayNameFor(a => a.DriverTonnagePrice)</p>
                    <span class="sm">@Model.DriverTonnagePrice.Value.ToString("N0")</span>
                </div>
            }
        </div>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>