@model IEnumerable<UserPlannerItem>

@{
    int i = 1;
    ViewData["pageId"] = 43;
    ViewData["Title"] = "محتویات کارتابل شخصی";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string userPlannerRowId = ViewData["UserPlannerRowId"].ToString();
}

@section Scripts{
    <script>
        function getUserPlannerItemDetail(id) {
            preloader();
            $.get('@Url.Action("GetUserPlannerItemDetail")', { 'id': id }, function (r) {
                $('#detail-modal #item-detail-content').html(r.content);
            }, 'json').then(function () {
                preloader();
                UIkit.modal('#detail-modal').show();
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
    </script>
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><a asp-action="UserPlanner" asp-controller="Admin">کارتابل شخصی</a></li>
            <li><span>محتویات</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a asp-action="CreateUserPlannerItem" asp-route-id="@userPlannerRowId" class="uk-button uk-button-primary">افزودن</a>
    </div>
</div>

<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Priority)</th>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th width="50">نمایش</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@item.Priority</td>
                        <td>@item.Title</td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="getUserPlannerItemDetail(@item.Id)"><i class="fas fa-eye"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" asp-action="EditUserPlannerItem" asp-route-id="@item.Id"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
<div id="detail-modal" class="uk-modal-container" uk-modal="bg-close: false">
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جزئیات</h2>
        </div>
        <div class="uk-modal-body">
            <div id="item-detail-content" class="box"></div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteUserPlannerItem" asp-controller="Admin">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>