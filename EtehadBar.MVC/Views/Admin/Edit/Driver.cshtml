@model Driver
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش راننده</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditDriver" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
                <div>
                    <label asp-for="Fullname" class="uk-form-label"></label>
                    <input asp-for="Fullname" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Fullname" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Phonenumber" class="uk-form-label"></label>
                    <input asp-for="Phonenumber" dir="ltr" maxlength="11" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Phonenumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="NationalNumber" class="uk-form-label"></label>
                    <input asp-for="NationalNumber" dir="ltr" maxlength="10" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="NationalNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="AccountBankName" class="uk-form-label"></label>
                    <input asp-for="AccountBankName" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="AccountBankName" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="BankAccountNumber" class="uk-form-label"></label>
                    <input asp-for="BankAccountNumber" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="BankAccountNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="IsActive" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="IsActive" value="true" @if(Model.IsActive){<text>checked="checked"</text>} /> فعال</label>
                        <label><input class="uk-radio" type="radio" name="IsActive" value="false" @if(!Model.IsActive){<text>checked="checked"</text>}  /> غیر فعال</label>
                    </div>
                    <span asp-validation-for="IsActive" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>