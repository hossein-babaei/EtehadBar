@model Customer

<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش @Model.Name</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditCustomer" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="Name" class="uk-form-label"></label>
                    <input asp-for="Name" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Name" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="HasAddonTonnage" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="HasAddonTonnage" value="true" @if (Model.HasAddonTonnage) { <text> checked</text> } /> دارد</label>
                        <label><input class="uk-radio" type="radio" name="HasAddonTonnage" value="false" @if (!Model.HasAddonTonnage) { <text> checked</text> } /> ندارد</label>
                    </div>
                    <span asp-validation-for="HasAddonTonnage" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="HasLoadType" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="HasLoadType" value="true" @if (Model.HasLoadType) { <text> checked</text> } /> دارد</label>
                        <label><input class="uk-radio" type="radio" name="HasLoadType" value="false" @if (!Model.HasLoadType) { <text> checked</text> } /> ندارد</label>
                    </div>
                    <span asp-validation-for="HasLoadType" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Status" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="Status" value="true" @if (Model.Status) { <text> checked</text> } /> فعال</label>
                        <label><input class="uk-radio" type="radio" name="Status" value="false" @if (!Model.Status) { <text> checked</text> } /> غیر فعال</label>
                    </div>
                    <span asp-validation-for="Status" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>