@model ShippingFeeGroup
@{
    var types = (List<Definition>)ViewData["Data"];
    var vehicles = types.Where(a => a.DefinitionType.Equals(DefinitionType.Car)).OrderBy(a => a.Title).ToList();
    var loadTypes = (List<ShippingFeeLoadType>)ViewData["LoadTypes"];
    var calendars = (List<Calendar>)ViewData["Calendars"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش نرخ</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditShippingFeeGroup" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ContractId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-2@m" uk-grid>
                <div class="uk-width-1-1">
                    <label asp-for="Title" class="uk-form-label"></label>
                    <input asp-for="Title" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="Title" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Vehicle" class="uk-form-label"></label>
                    <select asp-for="Vehicle" class="uk-select uk-border-rounded">
                        @foreach (var item in vehicles)
                        {
                            <!option value="@item.Title" @if(Model.Vehicle.Equals(item.Title)) {
                        <text>selected="selected"</text>
}>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="Vehicle" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Origin" class="uk-form-label"></label>
                    <input asp-for="Origin" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="Origin" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Destination" class="uk-form-label"></label>
                    <input asp-for="Destination" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="Destination" class="uk-text-danger"></span>
                </div>
                @if (Model.ShippingFeeLoadTypeId.Equals(-1))
                {
                    <input asp-for="ShippingFeeLoadTypeId" type="hidden" value="-1" />
                }
                else
                {
                    <div>
                        <label asp-for="ShippingFeeLoadTypeId" class="uk-form-label"></label>
                        <select asp-for="ShippingFeeLoadTypeId" class="uk-select uk-border-rounded">
                            @foreach (var item in loadTypes)
                            {
                                <!option value="@item.Id" @if(Model.ShippingFeeLoadTypeId.Equals(item.Id)) {
                        <text>selected="selected"</text>
}>@item.Name</!option>
                            }
                        </select>
                        <span asp-validation-for="ShippingFeeLoadTypeId" class="uk-text-danger"></span>
                    </div>
                }
                <div>
                    <label asp-for="Price" class="uk-form-label"></label>
                    <input asp-for="Price" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="Price" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DriverPrice" class="uk-form-label"></label>
                    <input asp-for="DriverPrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="DriverPrice" class="uk-text-danger"></span>
                </div>
                @if (Model.TonnagePrice.HasValue)
                {
                    <div>
                        <label asp-for="TonnagePrice" class="uk-form-label"></label>
                        <input asp-for="TonnagePrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded uk-form-small format-number" />
                        <span asp-validation-for="TonnagePrice" class="uk-text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="DriverTonnagePrice" class="uk-form-label"></label>
                        <input asp-for="DriverTonnagePrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded uk-form-small format-number" />
                        <span asp-validation-for="DriverTonnagePrice" class="uk-text-danger"></span>
                    </div>
                }
                <div class="uk-width-1-1"><hr /></div>
                <div>
                    <label class="uk-form-label">تغییر نرخ بارنامه ها از تاریخ</label>
                    <input class="uk-input uk-form-small uk-border-rounded datepicker" dir="ltr" name="DateLimit" />
                </div>
                <div>
                    <label class="uk-form-label">یا از تقویم کاری</label>
                    <select id="CalendarLimit" name="CalendarLimit">
                        <option value="0">بدون محدودیت تقویم کاری</option>
                        @foreach (var item in calendars)
                        {
                            <option value="@item.Id">@item.Title</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitEdit()">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>