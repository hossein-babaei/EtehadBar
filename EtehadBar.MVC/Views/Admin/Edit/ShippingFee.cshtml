@model ShippingFee
@{
    var types = (List<Definition>)ViewData["Data"];
    var vehicles = types.Where(a => a.DefinitionType.Equals(DefinitionType.Car)).OrderBy(a => a.Title).ToList();
    var loadRoutes = (List<LoadRoutes>)ViewData["LoadRoutes"];
    var origins = loadRoutes.Where(a => a.RouteType.Equals(LoadRouteType.Origin)).OrderBy(a => a.Title).ToList();
    var destinations = loadRoutes.Where(a => a.RouteType.Equals(LoadRouteType.Destionation)).OrderBy(a => a.Title).ToList();
    var loadTypes = (List<ShippingFeeLoadType>)ViewData["LoadTypes"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش نرخ</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditShippingFee" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ContractId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="ShippingFeeType" class="uk-form-label"></label>
                    <select asp-for="ShippingFeeType" class="uk-select" onchange="shippingFeeTypeChangeHandler(this)">
                        <!option value="@((int)ShippingFeeType.Normal)" @if(Model.ShippingFeeType == ShippingFeeType.Normal){<text>selected="selected"</text>}>نرخ ثابت</!option>
                        <!option value="@((int)ShippingFeeType.Custom)" @if(Model.ShippingFeeType == ShippingFeeType.Custom){<text>selected="selected"</text>}>نرخ ازاد</!option>
                    </select>
                    <span asp-validation-for="ShippingFeeType" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Vehicle" class="uk-form-label"></label>
                    <select asp-for="Vehicle" class="uk-select uk-border-rounded">
                        @foreach (var item in vehicles)
                        {
                            <!option value="@item.Title" @if(Model.Vehicle.Equals(item.Title)) {<text>selected="selected"</text>}>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="Vehicle" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="OriginId" class="uk-form-label"></label>
                    <select asp-for="OriginId" class="uk-select uk-border-rounded">
                        @foreach (var item in origins)
                        {
                            <!option value="@item.Id" @if(Model.OriginId.Equals(item.Id)) {<text>selected="selected"</text>}>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="OriginId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DestinationId" class="uk-form-label"></label>
                    <select asp-for="DestinationId" class="uk-select uk-border-rounded">
                        @foreach (var item in destinations)
                        {
                            <!option value="@item.Id" @if(Model.DestinationId.Equals(item.Id)) {<text>selected="selected"</text>}>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="DestinationId" class="uk-text-danger"></span>
                </div>
                @if (Model.ShippingFeeLoadTypeId.Equals(-1))
                {
                    <input asp-for="ShippingFeeLoadTypeId" type="hidden" value="-1" />
                }
                else
                {
                    <div>
                        <label asp-for="ShippingFeeLoadTypeId" class="uk-form-label"></label>
                        <select asp-for="ShippingFeeLoadTypeId" class="uk-select uk-border-rounded">
                            @foreach (var item in loadTypes)
                            {
                                <!option value="@item.Id" @if(Model.ShippingFeeLoadTypeId.Equals(item.Id)) {<text>selected="selected"</text>}>@item.Name</!option>
                            }
                        </select>
                        <span asp-validation-for="ShippingFeeLoadTypeId" class="uk-text-danger"></span>
                    </div> 
                }
                <div>
                    <label asp-for="Price" class="uk-form-label"></label>
                    <input asp-for="Price" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded format-number" />
                    <span asp-validation-for="Price" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DriverPrice" class="uk-form-label"></label>
                    <input asp-for="DriverPrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded format-number" />
                    <span asp-validation-for="DriverPrice" class="uk-text-danger"></span>
                </div>
                @if (Model.TonnagePrice.HasValue)
                {
                    <div>
                        <label asp-for="TonnagePrice" class="uk-form-label"></label>
                        <input asp-for="TonnagePrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded format-number" />
                        <span asp-validation-for="TonnagePrice" class="uk-text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="DriverTonnagePrice" class="uk-form-label"></label>
                        <input asp-for="DriverTonnagePrice" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded format-number" />
                        <span asp-validation-for="DriverTonnagePrice" class="uk-text-danger"></span>
                    </div>
                }
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>