@model EditUserPlannerVM
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditUserPlanner" method="post">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <h5 class="uk-text-bold">تاریخ</h5>
                    <div class="uk-grid-small uk-child-width-1-3" uk-grid>
                        <div>
                            <label asp-for="Day" class="uk-form-label"></label>
                            <select asp-for="Day" class="uk-select uk-border-rounded">
                                @for (int i = 1; i < 32; i++)
                                {
                                    <!option value="@i" @if (Model.Day.Equals(i)) { <text> selected="selected" </text> }>@i</!option>
                                }
                            </select>
                            <span asp-validation-for="Day" class="uk-text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="Month" class="uk-form-label"></label>
                            <select asp-for="Month" class="uk-select uk-border-rounded">
                                @for (int i = 1; i < 13; i++)
                                {
                                    <!option value="@i" @if (Model.Month.Equals(i)) { <text> selected="selected" </text> }>@i</!option>
                                }
                            </select>
                            <span asp-validation-for="Month" class="uk-text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="Year" class="uk-form-label"></label>
                            <select asp-for="Year" class="uk-select uk-border-rounded">
                                @for (int i = 1398; i < 1411; i++)
                                {
                                    <!option value="@i" @if (Model.Year.Equals(i)) { <text> selected="selected" </text> }>@i</!option>
                                }
                            </select>
                            <span asp-validation-for="Year" class="uk-text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>