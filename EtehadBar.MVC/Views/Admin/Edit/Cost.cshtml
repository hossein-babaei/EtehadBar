@model Cost
@{
    var calendar = (List<Calendar>)ViewData["Calendar"];
    var costAccounts = (List<Definition>)ViewData["CostAccount"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش هزینه</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditCost" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Date" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="CalendarId" class="uk-form-label"></label>
                    <select asp-for="CalendarId" class="uk-select uk-border-rounded">
                        @foreach (var item in calendar)
                        {
                            <!option value="@item.Id" @if (Model.CalendarId.Equals(item.Id)) { <text>selected="selected"</text> }>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="CalendarId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="CostAccountId" class="uk-form-label"></label>
                    <select asp-for="CostAccountId" class="uk-select uk-border-rounded">
                        @foreach (var item in costAccounts)
                        {
                            <!option value="@item.Id" @if (Model.CostAccountId.Equals(item.Id))
                            {
                                <text>selected="selected"</text>
                            }>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="CostAccountId" class="uk-text-danger"></span>
                </div>
                @{
                    var pd = new PersianDateTime(Model.Date);
                }
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">روز</label>
                    <select class="uk-select uk-border-rounded" name="day" dir="ltr">
                        @for (int i = 1; i < 32; i++)
                        {
                            <!option value="@i" @if (pd.Day == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">ماه</label>
                    <select class="uk-select uk-border-rounded" name="month" dir="ltr">
                        @for (int i = 1; i < 13; i++)
                        {
                            <!option value="@i" @if (pd.Month == i) { <text> selected="selected" </text> }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">سال</label>
                    <input class="uk-input uk-border-rounded" name="year" value="@pd.Year" dir="ltr" />
                </div>
                <div>
                    <label asp-for="Amount" class="uk-form-label"></label>
                    <input asp-for="Amount" dir="ltr" type="number" min="0" class="uk-input uk-border-rounded format-number" />
                    <span asp-validation-for="Amount" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Description" class="uk-form-label"></label>
                    <textarea asp-for="Description" class="uk-textarea uk-border-rounded" rows="2"></textarea>
                    <span asp-validation-for="Description" class="uk-text-danger"></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Picture))
                {
                    var pictures = Model.Picture.Split(";;");
                    <div>
                        <div class="uk-width-1-1 uk-padding">
                            تصویر فعلی رسید یا سند مالی را در زیر مشاهده میکنید.
                            <br />
                            اگر میخواهید آن را تغییر دهید یک تصویر انتخاب کنید. در غیر اینصورت آن را خالی بگذارید.
                        </div>
                        <div class="uk-width-1-1 uk-text-center">
                            <div class="uk-grid-small uk-child-width-auto" uk-grid>
                                @for (int i = 0; i < pictures.Length; i++)
                                {
                                    <div>
                                        <div uk-lightbox>
                                            <a class="uk-button uk-button-default uk-border-rounded uk-button-small" href="/img/cost/@pictures[i]">تصویر @(i + 1)</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="uk-text-center">
                    <div class="uk-margin-top">
                        <div><label class="uk-form-label">تصویر رسید یا سند مالی</label></div>
                        <input type="file" multiple class="pic" />
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitEditForm()">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>