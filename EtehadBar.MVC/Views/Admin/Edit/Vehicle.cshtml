@model Vehicle
@{
    var types = (List<Definition>)ViewData["Definition"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش خودرو</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditVehicle" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-flex-bottom uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="Type" class="uk-form-label"></label>
                    <select asp-for="Type" class="uk-select uk-border-rounded">
                        @foreach (var item in types)
                        {
                            <!option value="@item.Title" @if (Model.Type.Equals(item.Title)) { <text> selected="selected" </text> }>@item.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="Type" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-4">
                    <label asp-for="IranStateNumber" class="uk-form-label"></label>
                    <input asp-for="IranStateNumber" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="IranStateNumber" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-4">
                    <label asp-for="RightNumber" class="uk-form-label"></label>
                    <input asp-for="RightNumber" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="RightNumber" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-4">
                    <label asp-for="NumberWord" class="uk-form-label"></label>
                    <input asp-for="NumberWord" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="NumberWord" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-4">
                    <label asp-for="LeftNumber" class="uk-form-label"></label>
                    <input asp-for="LeftNumber" dir="ltr" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="LeftNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="VehicleOwnerFullname" class="uk-form-label"></label>
                    <input asp-for="VehicleOwnerFullname" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="VehicleOwnerFullname" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="AccountBankName" class="uk-form-label"></label>
                    <input asp-for="AccountBankName" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="AccountBankName" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="BankAccountNumber" class="uk-form-label"></label>
                    <input asp-for="BankAccountNumber" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="BankAccountNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Status" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="Status" value="true" @if (Model.Status) { <text> checked</text> } /> فعال</label>
                        <label><input class="uk-radio" type="radio" name="Status" value="false" @if (!Model.Status) { <text> checked</text> } /> غیر فعال</label>
                    </div>
                    <span asp-validation-for="Status" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="RealStatus" class="uk-form-label"></label>
                    <div class="uk-margin-small uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-radio" type="radio" name="RealStatus" value="true" @if (Model.RealStatus) { <text> checked</text> } /> بلی</label>
                        <label><input class="uk-radio" type="radio" name="RealStatus" value="false" @if (!Model.RealStatus) { <text> checked</text> }/> خیر</label>
                    </div>
                    <span asp-validation-for="RealStatus" class="uk-text-danger"></span>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>