@model EditTurnoverVM

<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditTurnover" method="post" autocomplete="off">
            <input autocomplete="false" name="hidden" type="text" style="display:none;">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <input asp-for="TurnoverType" type="hidden" />
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">روز</label>
                    <select asp-for="Day" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                        @for (int i = 1; i < 32; i++)
                        {
                            <!option value="@i" @if (Model.Day == i) {
                        <text> selected="selected" </text>
 }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">ماه</label>
                    <select asp-for="Month" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                        @for (int i = 1; i < 13; i++)
                        {
                            <!option value="@i" @if (Model.Month == i) {
                        <text> selected="selected" </text>
 }>@i</!option>
                        }
                    </select>
                </div>
                <div class="uk-width-1-3@m">
                    <label class="uk-form-label">سال</label>
                    <input class="uk-input uk-border-rounded uk-form-small" asp-for="Year" value="@Model.Year" dir="ltr" />
                </div>
                <div>
                    <label asp-for="Fullname" class="uk-form-label"></label>
                    <div class="autocomplete">
                        <input asp-for="Fullname" class="uk-input uk-border-rounded uk-form-small" />
                    </div>
                    <span asp-validation-for="Fullname" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Creditor" class="uk-form-label"></label>
                    <input asp-for="Creditor" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="Creditor" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Debtor" class="uk-form-label"></label>
                    <input asp-for="Debtor" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="Debtor" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Description" class="uk-form-label"></label>
                    <textarea asp-for="Description" class="uk-textarea uk-border-rounded uk-form-small" rows="3"></textarea>
                    <span asp-validation-for="Description" class="uk-text-danger"></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Attachments))
                {
                    var pictures = Model.Attachments.Split(";;");
                    <div>
                        <div class="uk-width-1-1 uk-padding">
                            تصویر فعلی رسید یا سند مالی را در زیر مشاهده میکنید.
                            <br />
                            اگر میخواهید آن را تغییر دهید یک تصویر انتخاب کنید. در غیر اینصورت آن را خالی بگذارید.
                        </div>
                        <div class="uk-width-1-1 uk-text-center">
                            <div class="uk-grid-small uk-child-width-auto" uk-grid>
                                @for (int i = 0; i < pictures.Length; i++)
                                {
                                    <div>
                                        <div uk-lightbox>
                                            <a class="uk-button uk-button-default uk-border-rounded uk-button-small" href="/img/turnover/@pictures[i]">تصویر @(i + 1)</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="uk-text-center">
                    <div class="uk-margin-top">
                        <div><label class="uk-form-label">تصویر رسید یا سند مالی</label></div>
                        <input type="file" multiple class="pic" />
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitEditForm()">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>