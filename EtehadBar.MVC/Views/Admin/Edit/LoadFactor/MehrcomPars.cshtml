@model EMehrcomParsLoadFactorVM
@{
    var fees = (List<ShippingFeeRouteWithPriceVM>)ViewData["Fees"];
    var contract = (List<Contract>)ViewData["Contracts"];
    var drivers = (List<Driver>)ViewData["Drivers"];
    var vehicles = (List<Vehicle>)ViewData["Vehicles"];
    var calendars = (List<Calendar>)ViewData["Calendars"];
    //var currentFee = fees.Where(a => a.Id.Equals(Model.ShippingFeeId)).First();
    var accountBooks = (List<AccountBook>)ViewData["AccountBooks"];
    var categories = (List<MehrcomParsCategory>)ViewData["Categories"];
    var loadFactorRegistors = (List<Definition>)ViewData["LoadFactorRegistors"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">ویرایش بارنامه مهرکام پارس</h2>
    </div>
    <div class="uk-modal-body">
        <form id="edit-form" asp-action="EditMehrcomParsLoadFactor" method="post">
            <input asp-for="Id" type="hidden" value="@Model.Id" />
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
                <div class="uk-width-1-5@m">
                     <label asp-for="AccountBookId" class="uk-form-label"></label>
                    <select asp-for="AccountBookId" class="uk-select uk-border-rounded uk-form-small">
                        @foreach (var accountBook in accountBooks.Where(a => a.IsOpen || a.Id.Equals(Model.AccountBookId)).ToList())
                        {
                            <!option value="@accountBook.Id" @if(Model.AccountBookId.Equals(accountBook.Id)) {<text>selected="selected"</text>}>@accountBook.Number (@(accountBook.IsOpen ? "باز" : "بسته"))</!option>
                        }
                    </select>
                    <span asp-validation-for="AccountBookId" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-5@m">
                    <label asp-for="CategoryId" class="uk-form-label"></label>
                    <select asp-for="CategoryId" class="uk-select uk-border-rounded uk-form-small">
                        @foreach (var category in categories)
                        {
                            <!option value="@category.Id" @if(Model.CategoryId.Equals(category.Id)){<text>selected="selected"</text>}>@category.Title</!option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-3-5@m">
                    <label asp-for="ContractId" class="uk-form-label"></label>
                    <select asp-for="ContractId" onchange="getShippingFees(this)" class="uk-select uk-border-rounded">
                        @foreach (var item in contract)
                        {
                            <!option value="@item.Id" @if (item.Id.Equals(Model.ContractId)) { <text> selected="selected" </text> }>@item.Subject - @item.Number (@(new PersianDateTime(item.StartDate).ToString("yyyy/MM/dd")) الی @(new PersianDateTime(item.EndDate).ToString("yyyy/MM/dd")))</!option>
                        }
                    </select>
                    <span asp-validation-for="ContractId" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-1-1@m">
                    <label asp-for="ShippingFeeRouteId" class="uk-form-label"></label>
                    <select asp-for="ShippingFeeRouteId" class="uk-select uk-border-rounded">
                        @*data-last-type="@fees.First(a => a.Id.Equals(Model.ShippingFeeId)).ShippingFeeType" onchange="loadFactorFormShippingFeeChangeHandler(this, '@CustomerType.MehrcomPars')"*@
                        @foreach (var item in fees)
                        {
                            <!option value="@item.Id" data-vehicle-type="@item.Vehicle" @*data-type="@item.ShippingFeeType"*@ 
                                @if(Model.ShippingFeeRouteId.HasValue && item.Id.Equals(Model.ShippingFeeRouteId)){ <text>selected="selected"</text> }>@(string.IsNullOrWhiteSpace(item.Title) ? "" : $"({item.Title}) ")@item.Vehicle - (@item.Origin به @item.Destination - @item.ShippingFeeLoadType) - @item.Price.ToString("N0")</!option>
                        }
                    </select>
                    <span asp-validation-for="ShippingFeeRouteId" class="uk-text-danger"></span>
                </div>
                @*@if (currentFee.ShippingFeeType == ShippingFeeType.Custom)
                {
                    <div class="uk-grid-margin uk-first-column">
                        <label class="uk-form-label" for="Amount">مبلغ (دریافتی)</label>
                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" data-val-required="پر کردن این فیلد الزامی است." id="Amount" maxlength="128" name="Amount" value="@Model.Amount">
                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="Amount" data-valmsg-replace="true"></span>
                    </div>
                    <div class="uk-grid-margin uk-first-column">
                        <label class="uk-form-label" for="DriverFee">کرایه راننده (ریال)</label>
                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" data-val-required="پر کردن این فیلد الزامی است." id="DriverFee" maxlength="128" name="DriverFee" value="@Model.DriverFee">
                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="DriverFee" data-valmsg-replace="true"></span>
                    </div>
                    <div class="uk-grid-margin uk-first-column">
                        <label class="uk-form-label" for="TonnagePrice">نرخ تناژ اضافه (ریال)</label>
                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" id="TonnagePrice" name="TonnagePrice" value="@Model.TonnagePrice">
                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="TonnagePrice" data-valmsg-replace="true"></span>
                    </div>
                    <div class="uk-grid-margin uk-first-column">
                        <label class="uk-form-label" for="DriverTonnagePrice">نرخ تناژ اضافه راننده (ریال)</label>
                        <input dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" type="text" data-val="true" id="DriverTonnagePrice" name="DriverTonnagePrice" value="@Model.DriverTonnagePrice">
                        <span class="uk-text-danger field-validation-valid" data-valmsg-for="DriverTonnagePrice" data-valmsg-replace="true"></span>
                    </div>
                }*@
                <div>
                    <label asp-for="VehicleId" class="uk-form-label"></label>
                    <select asp-for="VehicleId" class="uk-select uk-border-rounded">
                        @foreach (var item in vehicles)
                        {
                            <!option value="@item.Id" data-vehicle-type="@item.Type" @if (item.Id.Equals(Model.VehicleId)) { <text> selected="selected" </text> }>@item.Type | ایران @item.IranStateNumber - @item.RightNumber @item.NumberWord @item.LeftNumber</!option>
                        }
                    </select>
                    <span asp-validation-for="VehicleId" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DriverId" class="uk-form-label"></label>
                    <select asp-for="DriverId" class="uk-select uk-border-rounded">
                        @foreach (var item in drivers)
                        {
                            <!option value="@item.Id" @if (item.Id.Equals(Model.DriverId)) { <text> selected="selected" </text> }>@item.Fullname (@item.NationalNumber)</!option>
                        }
                    </select>
                    <span asp-validation-for="DriverId" class="uk-text-danger"></span>
                </div>
                @{
                    var now = PersianDateTime.Now;
                }
                <div class="uk-width-1-1">
                    <div class="uk-grid-small" uk-grid>
                        <div class="uk-width-2-5@m">
                            <label asp-for="CalendarId" class="uk-form-label"></label>
                            <select asp-for="CalendarId" class="uk-select uk-border-rounded uk-form-small">
                                @foreach (var item in calendars)
                                {
                                    <!option value="@item.Id" @if (item.Id.Equals(Model.CalendarId)) { <text> selected="selected" </text> }>@item.Title - (@(new PersianDateTime(item.StartDate).ToString("yyyy/MM/dd")) الی @(new PersianDateTime(item.EndDate).ToString("yyyy/MM/dd")))</!option>
                                }
                            </select>
                            <span asp-validation-for="CalendarId" class="uk-text-danger"></span>
                        </div>
                        <div class="uk-width-1-5@m">
                            <label class="uk-form-label">روز</label>
                            <select asp-for="Day" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                                @for (int i = 1; i < 32; i++)
                                {
                                    <!option value="@i" @if (Model.Day == i)
                                    {
                                        <text> selected="selected" </text>
                                    }>@i</!option>
                                }
                            </select>
                        </div>
                        <div class="uk-width-1-5@m">
                            <label class="uk-form-label">ماه</label>
                            <select asp-for="Month" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                                @for (int i = 1; i < 13; i++)
                                {
                                    <!option value="@i" @if (Model.Month == i)
                                    {
                                        <text> selected="selected" </text>
                                    }>@i</!option>
                                }
                            </select>
                        </div>
                        <div class="uk-width-1-5@m">
                            <label class="uk-form-label">سال</label>
                            <input class="uk-input uk-border-rounded uk-form-small" asp-for="Year" dir="ltr" />
                        </div>
                    </div>
                </div>
                <div>
                    <label asp-for="LoadNumber" class="uk-form-label"></label>
                    <input asp-for="LoadNumber" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                    <span asp-validation-for="LoadNumber" class="uk-text-danger"></span>
                </div>
                <div>
                    <div class="uk-margin uk-margin-top uk-grid-small uk-child-width-auto uk-grid">
                        <label><input class="uk-checkbox uk-border-rounded" onchange="checkboxBoolean(this)" type="checkbox" name="Load" id="Load" value="@(Model.Load ? "True" : "False")" @if(Model.Load){<text>checked</text>}/> بار</label>
                        <label><input class="uk-checkbox uk-border-rounded" onchange="checkboxBoolean(this)" type="checkbox" name="Palette" id="Palette" value="@(Model.Palette ? "True" : "False")" @if(Model.Palette){<text>checked</text>}/> پالت</label>
                        <label><input class="uk-checkbox uk-border-rounded" onchange="checkboxBoolean(this)" type="checkbox" name="Return" id="Return" value="@(Model.Return ? "True" : "False")" @if(Model.Return){<text>checked</text>}/> برگشتی</label>
                    </div>
                </div>
                <div>
                    <label asp-for="TonnagePrice" class="uk-form-label"></label>
                    <input asp-for="TonnagePrice" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="TonnagePrice" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="DriverTonnagePrice" class="uk-form-label"></label>
                    <input asp-for="DriverTonnagePrice" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="DriverTonnagePrice" class="uk-text-danger"></span>
                </div>
                @*<div>
                    <label asp-for="LoadType" class="uk-form-label"></label>
                    <select asp-for="LoadType" class="uk-select uk-border-rounded uk-form-small">
                        <!option value="کالا" @if(Model.LoadType == "کالا") { <text>selected="selected"</text> }>کالا</!option>
                        <!option value="صندلی" @if(Model.LoadType == "صندلی") { <text>selected="selected"</text> }>صندلی</!option>
                    </select>
                    <span asp-validation-for="LoadType" class="uk-text-danger"></span>
                </div>*@
                <div>
                    <label asp-for="WeighbridgePrice" class="uk-form-label"></label>
                    <input asp-for="WeighbridgePrice" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
                    <span asp-validation-for="WeighbridgePrice" class="uk-text-danger"></span>
                </div>
                <div class="uk-width-expand@m">
                    <div class="uk-grid-small" uk-grid>
                        <div class="uk-width-1-3@m">
                            <label asp-for="LoadSleepTime" class="uk-form-label"></label>
                            <input asp-for="LoadSleepTime" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                            <span asp-validation-for="LoadSleepTime" class="uk-text-danger"></span>
                        </div>
                        <div class="uk-width-1-3@m">
                            <label asp-for="LoadSleepPrice" class="uk-form-label"></label>
                            <input asp-for="LoadSleepPrice" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                            <span asp-validation-for="LoadSleepPrice" class="uk-text-danger"></span>
                        </div>
                        <div class="uk-width-1-3@m">
                            <label asp-for="DriverLoadSleepPrice" class="uk-form-label"></label>
                            <input asp-for="DriverLoadSleepPrice" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                            <span asp-validation-for="DriverLoadSleepPrice" class="uk-text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="uk-width-auto">
                    <div class="uk-margin-top">
                        <label><input class="uk-checkbox uk-border-rounded" type="checkbox" name="HasAddonMessage" id="HasAddonMessage" onchange="checkboxBoolean(this)" value="@(Model.HasAddonMessage ? "True" : "False")" @if(Model.HasAddonMessage){<text>checked</text>}> افزایش 30% دارد</label>
                    </div>
                </div>
                <div class="uk-width-1-1">
                    <div class="box">
                        <h5 class="uk-text-center">اطلاعات بارنامه دولتی</h5>
                        <hr />
                        <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
                            <div>
                                <div class="uk-grid-small" uk-grid>
                                    <div class="uk-width-1-3@m">
                                        <label class="uk-form-label">روز</label>
                                        <select asp-for="GovDay" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                                            @for (int i = 1; i < 32; i++)
                                            {
                                                <!option value="@i" @if (Model.GovDay == i)
                                                {
                                                    <text> selected="selected" </text>
                                                }>@i</!option>
                                            }
                                        </select>
                                    </div>
                                    <div class="uk-width-1-3@m">
                                        <label class="uk-form-label">ماه</label>
                                        <select asp-for="GovMonth" class="uk-select uk-border-rounded uk-form-small uk-text-right" dir="ltr">
                                            @for (int i = 1; i < 13; i++)
                                            {
                                                <!option value="@i" @if (Model.GovMonth == i)
                                                {
                                                    <text> selected="selected" </text>
                                                }>@i</!option>
                                            }
                                        </select>
                                    </div>
                                    <div class="uk-width-1-3@m">
                                        <label class="uk-form-label">سال</label>
                                        <input class="uk-input uk-border-rounded uk-form-small" asp-for="GovYear" dir="ltr" />
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label asp-for="LoadNumberGov" class="uk-form-label"></label>
                                <input asp-for="LoadNumberGov" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                                <span asp-validation-for="LoadNumberGov" class="uk-text-danger"></span>
                            </div>
                            <div class="uk-width-1-3@m">
                                <label asp-for="LoadNumberGovReturn" class="uk-form-label"></label>
                                <input asp-for="LoadNumberGovReturn" dir="ltr" class="uk-input uk-border-rounded uk-form-small" />
                                <span asp-validation-for="LoadNumberGovReturn" class="uk-text-danger"></span>
                            </div>
                            <div class="uk-width-1-3@m">
                                <label asp-for="LoadFactorGovAmount" class="uk-form-label"></label>
                                <input asp-for="LoadFactorGovAmount" dir="ltr" class="uk-input uk-border-rounded uk-form-small format-number" />
                                <span asp-validation-for="LoadFactorGovAmount" class="uk-text-danger"></span>
                            </div>
                            <div class="uk-width-1-3@m">
                                <label asp-for="LoadFactorGovRegistorId" class="uk-form-label"></label>
                                <select class="uk-select uk-border-rounded uk-form-small" asp-for="LoadFactorGovRegistorId">
                                    <!option value="0" @if (!Model.LoadFactorGovRegistorId.HasValue)
                                    {
                                        <text>selected="selected"</text>
                                    }>فاقد بارنامه دولتی</!option>
                                    @foreach (var item in loadFactorRegistors)
                                    {
                                        <!option value="@item.Id" @if (Model.LoadFactorGovRegistorId.Equals(item.Id))
                                        {
                                            <text>selected="selected"</text>
                                        }>@item.Title</!option>
                                    }
                                </select>
                                <span asp-validation-for="LoadFactorGovRegistorId" class="uk-text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="uk-grid-small uk-child-width-auto uk-grid">
                        <label>بارنامه موردی</label>
                        <label><input class="uk-radio" type="radio" id="IsFreeDriverPrice" name="IsFreeDriverPrice" value="true" @if(Model.IsFreeDriverPrice){<text>checked</text>}> بلی</label>
                        <label><input class="uk-radio" type="radio" id="IsFreeDriverPrice" name="IsFreeDriverPrice" value="false" @if(!Model.IsFreeDriverPrice){<text>checked</text>}> خیر</label>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#edit-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>