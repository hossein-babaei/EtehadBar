@model ChangePasswordVM

@{
    ViewData["pageId"] = 20;
    ViewData["Title"] = "تغییر کلمه عبور";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a class="uk-button uk-button-secondary uk-margin-small-right" asp-action="Index" asp-controller="Admin">بازگشت</a>
    </div>
</div>

<form id="edit-form" asp-action="ChangePassword" asp-controller="Admin" method="post">
    <div class="uk-grid-small uk-child-width-1-1" uk-grid>
        <div>
            <div class="box">
                <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
                <div class="uk-grid-medium uk-child-width-1-1" uk-grid>
                    <div>
                        <label asp-for="OldPassword"></label>
                        <input asp-for="OldPassword" dir="ltr" class="uk-input uk-border-rounded">
                        <span asp-validation-for="OldPassword" class="uk-text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" dir="ltr" class="uk-input uk-border-rounded">
                        <span asp-validation-for="NewPassword" class="uk-text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" dir="ltr" class="uk-input uk-border-rounded">
                        <span asp-validation-for="ConfirmPassword" class="uk-text-danger"></span>
                    </div>
                    
                </div>
            </div>
        </div>
        <div>
            <div class="box uk-text-center">
                <button type="submit" class="uk-button uk-button-primary">ثبت اطلاعات</button>
            </div>
        </div>
    </div>
</form>