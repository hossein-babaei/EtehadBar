@model IEnumerable<ShippingFee>

@{
    int i = 1;
    var contractInfo = (Contract)ViewData["Contract"];
}
<div class="uk-overflow-auto">
    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>@Html.DisplayNameFor(model => model.Vehicle)</th>
                <th>@Html.DisplayNameFor(model => model.OriginId)</th>
                <th>@Html.DisplayNameFor(model => model.DestinationId)</th>
                <th>@Html.DisplayNameFor(model => model.ShippingFeeType)</th>
                @if (contractInfo.Customer.HasLoadType)
                {
                    <th>@Html.DisplayNameFor(model => model.ShippingFeeLoadTypeId)</th>
                }
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th>@Html.DisplayNameFor(model => model.DriverPrice)</th>
                @if (contractInfo.Customer.HasAddonTonnage)
                {
                    <th>@Html.DisplayNameFor(model => model.TonnagePrice)</th>
                    <th>@Html.DisplayNameFor(model => model.DriverTonnagePrice)</th>
                }
                <th width="50">بارنامه ها</th>
                <th width="50">ویرایش</th>
                <th width="50">حذف</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string type = "نرخ ثابت";
                if (item.ShippingFeeType == ShippingFeeType.Custom)
                    type = "نرخ آزاد";

                <tr class="uk-text-center sm">
                    <td>@i</td>
                    <td>@item.Vehicle</td>
                    <td>@item.Origin.Title</td>
                    <td>@item.Destination.Title</td>
                    <td>@type</td>
                    @if (contractInfo.Customer.HasLoadType)
                    {
                        <td>@item.ShippingFeeLoadType.Name</td>
                    }
                    <td>@item.Price.ToString("N0")</td>
                    <td>@item.DriverPrice.ToString("N0")</td>
                    @if (contractInfo.Customer.HasAddonTonnage)
                    {
                        <td>@(item.TonnagePrice.HasValue ? item.TonnagePrice.Value.ToString("N0") : "---")</td>
                        <td>@(item.DriverTonnagePrice.HasValue ? item.DriverTonnagePrice.Value.ToString("N0") : "---")</td>
                    }
                    <td><a class="uk-button uk-button-primary uk-button-small"><i class="fas fa-clipboard-check"></i></a></td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit('@item.Id')"><i class="far fa-edit"></i></a></td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove('@item.Id')"><i class="fas fa-trash-alt"></i></a></td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>