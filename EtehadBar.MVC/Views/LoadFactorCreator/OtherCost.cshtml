@using EtehadBar.Domain.Models.LoadFactorCreator
@model OtherCost
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["pageId"] = 43;
    var data = ViewBag.data as IPagedList<OtherCost>;
    ViewData["Title"] = "هزینه ساز";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int i = 1;
    if (data.PageNumber > 1)
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
}

@section Links {
    <link href="~/css/autocomplete.css" rel="stylesheet" asp-asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/autocomplete.js"></script>
    <script>
        let isSearchLoaded = false,
            isSumLoaded = false,
            autoCompleteData = [];
        let select2Config = {
            width: '100%',
            matcher: ignoreSpecialCharAndWhitespaceInSelect2
        };
        function vehicleSelectChangeHandler(select) {
            let ownerName = $(select).find('option:selected').data('owner');
            $(select).parent().next().find('input').val(ownerName);
        }
        async function createGroup() {
            preloader();
            await $.get('@Url.Action("CreateGroupOtherCost")', {}, function (r) {
                let modal = $('#create-group-modal');
                modal.html(r);
                modal.find('#CalendarId').select2(select2Config);

                modal.find('form').submit(function (e) {
                    e.preventDefault();
                    submitCreateGroupForm();
                });
            }, 'html').then(function () {
                parseValidator('#create-group-form');
                preloader();
                UIkit.modal('#create-group-modal').show();
            });
        }
        function submitCreateGroupForm() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CreateGroupOtherCost")',
                data: $('#create-group-modal form').serialize(),
                dataType: 'json',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    uiAlert(r.msg, r.status);
                    if (r.status == 'success') {
                        $.post('@Url.Action("OtherCost_Search")', { }, function (r) {
                            $('#append').html(r);
                        }, 'html');
                    }
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        async function create() {
            preloader();
            if (autoCompleteData.length == 0) {
                await $.get('@Url.Action("GetOtherCostDriverNames")', {}, function (r) {
                    $.each(r, (i, v) => {
                        autoCompleteData.push(v);
                    });
                }, 'json');
            }
            await $.get('@Url.Action("CreateOtherCost")', {}, function (r) {
                $('#create-modal').html(r);

                $('#create-modal #CalendarId').select2(select2Config);
                $('#create-modal #VehicleId').select2(select2Config);

                $('#create-modal form').submit(function (e) {
                    e.preventDefault();
                    submitCreateForm();
                });

                autocomplete($('#create-form #DriverName').get(0), autoCompleteData);
            }, 'html').then(function () {
                parseValidator('#create-form');
                preloader();
                UIkit.modal('#create-modal').show();
            });
        }
        function submitCreateForm() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CreateOtherCost")',
                data: $('#create-modal form').serialize(),
                dataType: 'json',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    uiAlert(r.msg, r.status);
                    if (r.status == 'success') {
                        $.post('@Url.Action("OtherCost_Search")', { }, function (r) {
                            $('#append').html(r);
                        }, 'html');
                    }
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function edit(id) {
            preloader();
            $.get('@Url.Action("EditOtherCost")', { 'id': id }, function (r) {
                $('#edit-modal').html(r);

                $('#edit-modal #CalendarId').select2(select2Config);
                $('#edit-modal #VehicleId').select2(select2Config);

                autocomplete($('#edit-form #DriverName').get(0), autoCompleteData);
            }, 'html').then(function () {
                parseValidator('#edit-modal form');
                preloader();
                UIkit.modal('#edit-modal').show();
            });
        }
        function submitEditForm() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("EditOtherCost")',
                data: $('#edit-modal form').serialize(),
                dataType: 'json',
                beforeSend: function () {
                    preloader();
                },
                    success: function (r) {
                    uiAlert(r.msg, r.status);
                    if (r.status == 'success') {
                        let dataTag = $('#append > div');
                        data = {
                            'p': dataTag.data('page'),
                            'customerId': dataTag.data('customer'),
                            'calendarId': dataTag.data('calendar')
                        };
                        $.post('@Url.Action("OtherCost_Search")', data, function (r) {
                           $('#append').html(r);
                        }, 'html');
                    }
                    UIkit.modal('#edit-modal').hide();
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
        function remove(id) {
            $('#delete-modal input').val(id);
            UIkit.modal('#delete-modal').show();
        }
        function filter() {
            var data = $('#search-modal form').serialize();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("OtherCost_Search")',
                data: data,
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger')
                },
                complete: function () {
                    preloader();
                    UIkit.modal('#search-modal').hide();
                }
            });
        }
        function getSearch() {
        if (!isSearchLoaded) {
            preloader();
            $.get('@Url.Action("OtherCost_Search")', {}, function (r) {
                let customerOptions = '<option value="0">همه</option>',
                    vehicleOptions = '<option value="0">همه</option>',
                    calendarOptions = '<option value="0">همه</option>';

                $.each(r.customers, (i, v) => {
                    customerOptions += `<option value="${v.id}">${v.name}</option>`;
                });
                $.each(r.vehicles, (i, v) => {
                    vehicleOptions += `<option value="${v.id}">${v.name} - ${v.number}</option>`;
                });
                $.each(r.calendars, (i, v) => {
                    calendarOptions += `<option value="${v.id}">${v.title}</option>`;
                });
                $('#search-modal #customerId').html(customerOptions);
                $('#search-modal #vehicleId').html(vehicleOptions);
                $('#search-modal #calendarId').html(calendarOptions);

                $('#search-modal #customerId').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
                $('#search-modal #vehicleId').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
                $('#search-modal #calendarId').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
                $('#search-modal #cost').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
            }, 'json').then(function () {
                    preloader();
                    UIkit.modal('#search-modal').show();
                    isSearchLoaded = true;
                });
            } else {
                UIkit.modal('#search-modal').show();
            }
        }
        function getSum() {
            if (!isSumLoaded) {
            preloader();
            $.get('@Url.Action("OtherCost_Search")', {}, function (r) {
                let customerOptions = '<option value="0">همه</option>',
                    calendarOptions = '<option value="0">همه</option>';

                $.each(r.customers, (i, v) => {
                    customerOptions += `<option value="${v.id}">${v.name}</option>`;
                });
                $.each(r.calendars, (i, v) => {
                    calendarOptions += `<option value="${v.id}">${v.title}</option>`;
                });
                $('#sum-modal #customerId').html(customerOptions);
                $('#sum-modal #calendarId').html(calendarOptions);

                $('#sum-modal #customerId').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
                $('#sum-modal #calendarId').select2({
                    width: '100%',
                    matcher: ignoreSpecialCharAndWhitespaceInSelect2
                });
            }, 'json').then(function () {
                    preloader();
                    UIkit.modal('#sum-modal').show();
                    isSumLoaded = true;
                });
            } else {
                UIkit.modal('#sum-modal').show();
            }
        }
        function calcSum(){
            var data = $('#sum-modal form').serialize();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CalculateOtherCostSum")',
                data: data,
                dataType: 'json',
                beforeSend: function () {
                preloader();
            },
            success: function (r) {
                $('#sum-modal .result').text(r);
            },
            error: function (e) {
                uiAlert(e.responseText, 'danger');
            },
            complete: function () {
                preloader();
            }
            });
        }
    </script>
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a class="uk-button uk-button-primary uk-margin-small-left" onclick="create()">افزودن</a>
        <a class="uk-button uk-button-secondary uk-margin-small-left" onclick="getSearch()">جستجو</a>
        <a class="uk-button uk-button-secondary uk-margin-small-left" onclick="getSum()">جمع کل</a>
        <a class="uk-button uk-button-danger" onclick="createGroup()">افزودن خودکار گروهی</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.DriverName)</th>
                    <th>پلاک</th>
                    <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    <th>@Html.DisplayNameFor(model => model.CalendarId)</th>
                    <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                    <th>قبض</th>
                    <th width="50">ویرایش</th>
                    <th width="50">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr class="uk-text-center">
                        <td>@i</td>
                        <td>@Html.DisplayFor(modelItem => item.DriverName)</td>
                        <td class="uk-text-bold">ایران @item.Vehicle.IranStateNumber - @item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                        <td>@item.Amount.ToString("N0")</td>
                        <td>@item.Calendar.Title</td>
                        <td>@item.Customer.Name</td>
                        <td>
                            @if (item.BillId.HasValue)
                            {
                                <span class="uk-text-success">دارد</span>
                            }
                            else
                            {
                                <span class="uk-text-danger">ندارد</span>
                            }
                        </td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                        <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
    @if (data.PageCount > 1)
    {
        <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
            @Html.PagedListPager(data, page => Url.Action("OtherCost", new { p = page }))
        </div>
    }
</div>
<div id="create-modal" uk-modal="bg-close: false"></div>
<div id="create-group-modal" uk-modal="bg-close: false"></div>
<div id="edit-modal" uk-modal="bg-close: false"></div>
<div id="delete-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-text-center uk-margin-auto-vertical">
        <form id="delete-form" method="post" asp-action="DeleteOtherCost" asp-controller="LoadFactorCreator">
            <input type="hidden" name="id" />
            <h3>آیا از حذف این مورد اطمینان دارید؟</h3>
            <p class="uk-text-danger uk-text-bold">هشدار! این عملیات قابل بازگشت نیست</p>
            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="$('#delete-form').submit()" type="button">بلی</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">خیر</button>
            </div>
        </form>
    </div>
</div>

<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                    <div>
                        <label class="uk-form-label">بر اساس مشتری</label>
                        <select class="uk-select uk-border-rounded" id="customerId" name="customerId"></select>
                    </div>
                    <div>
                        <label class="uk-form-label">بر اساس تقویم کاری</label>
                        <select class="uk-select uk-border-rounded" id="calendarId" name="calendarId"></select>
                    </div>
                    <div>
                        <label class="uk-form-label">بر اساس خودرو</label>
                        <select class="uk-select uk-border-rounded" id="vehicleId" name="vehicleId"></select>
                    </div>
                    <div>
                        <label class="uk-form-label"> وضعیت قبض</label>
                        <select class="uk-select uk-border-rounded" id="bill" name="bill">
                            <option value="0" selected="selected">بدون فیلتر</option>
                            <option value="1">دارد</option>
                            <option value="2">ندارد</option>
                        </select>
                    </div>
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="OtherCost" asp-controller="Admin" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="sum-modal" class="uk-flex-top" uk-modal>
    <div class="uk-modal-dialog uk-modal-body uk-margin-auto-vertical">
        <form>
            <p class="uk-text-bold uk-text-center">برای محاسبه مجموع یک ماه مشتری، اطلاعات ان را وارد نمائید.</p>
                <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                    <div>
                        <label class="uk-form-label"> مشتری</label>
                        <select class="uk-select uk-border-rounded" id="customerId" name="customerId"></select>
                    </div>
                    <div>
                        <label class="uk-form-label"> تقویم کاری</label>
                        <select class="uk-select uk-border-rounded" id="calendarId" name="calendarId"></select>
                    </div>
                    <div>
                        <label class="uk-form-label"> وضعیت قبض</label>
                        <select class="uk-select uk-border-rounded" id="bill" name="bill">
                            <option value="0" selected="selected">بدون فیلتر</option>
                            <option value="1">دارد</option>
                            <option value="2">ندارد</option>
                        </select>
                    </div>
                </div>
            <hr />
            <p class="uk-text-bold uk-text-center">حاصل جمع: <span class="result">0</span></p>

            <div class="uk-modal-footer uk-text-center">
                <button class="uk-button uk-button-primary" onclick="calcSum()" type="button">محاسبه و نمایش</button>
                <button class="uk-button uk-button-danger uk-modal-close" type="button">انصراف</button>
            </div>
        </form>
    </div>
</div>