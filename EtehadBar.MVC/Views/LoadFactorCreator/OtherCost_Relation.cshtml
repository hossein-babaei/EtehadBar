@using EtehadBar.Domain.Models.LoadFactorCreator
@model IEnumerable<OtherCost>

@{
    int i = 1;
    long billId = (long)ViewData["BillId"];
}
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <div class="uk-grid-small uk-child-width-1-1 uk-child-width-1-2@m" uk-grid>
            <div>
                <h2 class="uk-modal-title">انتقال به قبض جدید</h2>
            </div>
            <div>
                <div class="uk-grid-small uk-child-width-auto uk-flex uk-flex-left" uk-grid>
                    <div>
                        <a onclick="selectAllCosts()" class="uk-button uk-button-primary select-btn">انتخاب همه</a>
                    </div>
                    <div>
                        <a class="uk-button uk-button-secondary" onclick="$('#relation-modal form').submit()">ثبت</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="uk-modal-body">
        @if (Model.Any())
        {
            <div id="SelectedAmount">
                <div class="uk-grid-small uk-child-width-1-1 uk-text-center" uk-grid>
                    <div>
                        <h6>جمع کل: <span data-amount="0">0</span> ریال</h6>
                    </div>
                </div>
            </div>
            <div class="uk-overflow-auto">
                <form action="@Url.Action("SubmitBillCostRelation")" method="post">
                    <input type="hidden" name="BillId" value="@billId" />
                    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>@Html.DisplayNameFor(model => model.DriverName)</th>
                                <th>پلاک</th>
                                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                                <th width="50">انتخاب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="uk-text-center">
                                    <td>@i</td>
                                    <td>@Html.DisplayFor(modelItem => item.DriverName)</td>
                                    <td class="uk-text-bold">ایران @item.Vehicle.IranStateNumber - @item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>
                                        <div class="uk-flex uk-flex-middle uk-flex-center">
                                            <input data-amount="@item.Amount" value="@item.Id" name="IdList[]" class="uk-checkbox uk-border-rounded" type="checkbox" />
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </form>
            </div>
        }
        else
        {
            <div class="uk-margin-medium-top uk-margin-medium-bottom">
                <div class="uk-grid-large uk-text-center uk-child-width-1-1" uk-grid>
                    <div><i class="fas fa-4x fa-exclamation-triangle uk-text-danger"></i></div>
                    <div>
                        <h2>نتیجه ای یافت نشد.</h2>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="$('#relation-modal form').submit()">ثبت</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بستن</button>
    </div>
</div>