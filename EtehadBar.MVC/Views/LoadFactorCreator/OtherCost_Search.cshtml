@using EtehadBar.Domain.Models.LoadFactorCreator
@model OtherCost
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var data = ViewBag.data as IPagedList<OtherCost>;
    int i = 1;
    if (data.PageNumber > 1)
        i = (data.PageSize * data.PageNumber) - (data.PageSize - 1);
}

<div class="uk-overflow-auto">
    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>@Html.DisplayNameFor(model => model.DriverName)</th>
                <th>پلاک</th>
                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                <th>@Html.DisplayNameFor(model => model.CalendarId)</th>
                <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                <th width="50">ویرایش</th>
                <th width="50">حذف</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in data)
            {
                <tr class="uk-text-center">
                    <td>@i</td>
                    <td>@Html.DisplayFor(modelItem => item.DriverName)</td>
                    <td class="uk-text-bold">ایران @item.Vehicle.IranStateNumber - @item.Vehicle.RightNumber @item.Vehicle.NumberWord @item.Vehicle.LeftNumber</td>
                    <td>@item.Amount.ToString("N0")</td>
                    <td>@item.Calendar.Title</td>
                    <td>@item.Customer.Name</td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="edit(@item.Id)"><i class="far fa-edit"></i></a></td>
                    <td><a class="uk-button uk-button-primary uk-button-small" onclick="remove(@item.Id)"><i class="fas fa-trash-alt"></i></a></td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
@if (data.PageCount > 1)
{
    <div class="uk-text-center uk-width-1-1 uk-margin-top" dir="ltr">
        @Html.PagedListPager(data, page => Url.Action("OtherCost_Search", new { p = data.PageNumber }), X.PagedList.Mvc.Core.Common.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(new AjaxOptions() { HttpMethod = "POST", UpdateTargetId = "append", LoadingElementId = "preloader", OnSuccess = "goUp" }))
    </div>
}