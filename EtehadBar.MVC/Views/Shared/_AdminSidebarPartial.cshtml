@{
    var param = (int)ViewData["pageId"];
}
<ul class="uk-nav-default uk-nav-parent-icon" uk-nav>
    <li>
        <a class="uk-text-center">
            @{
                var date = PersianDateTime.Now.ToString("yyyy/MM/dd");
                <span class="uk-text-bold" dir="ltr">@date - <span class="main-clock"></span></span>
            }
        </a>
    </li>
    <li @if (param == 1) { <text> class="active" </text> }>
        <a asp-action="Index" asp-controller="Admin"><i class="uk-margin-left fas fa-tachometer-alt"></i>داشبورد</a>
    </li>
    <li @if (param == 2) { <text> class="active" </text> }>
        <a asp-action="Definition" asp-controller="Admin"><i class="uk-margin-left fas fa-book-open"></i>تعاریف</a>
    </li>
    <li @if (param == 3) { <text> class="active" </text> }>
        <a asp-action="Calendar" asp-controller="Admin"><i class="uk-margin-left fas fa-calendar"></i>تقویم کاری</a>
    </li>
    <li @if (param == 20) { <text> class="active" </text> }>
        <a asp-action="Users" asp-controller="Admin"><i class="uk-margin-left fas fa-users"></i>کاربران</a>
    </li>
    <li @if (param == 8) { <text> class="active" </text> }>
        <a asp-action="LoadFactor" asp-controller="Admin"><i class="uk-margin-left fas fa-clipboard-check"></i>بارنامه ها</a>
    </li>
    <li @if (param == 6) { <text> class="active" </text> }>
        <a asp-action="Vehicle" asp-controller="Admin"><i class="uk-margin-left fas fa-truck"></i>خودرو ها</a>
    </li>
    <li @if (param == 13) { <text> class="active" </text> }>
        <a asp-action="Customer" asp-controller="Admin"><i class="uk-margin-left fas fa-user"></i>مشتریان خدمات</a>
    </li>
    <li @if (param == 7) { <text> class="active" </text> }>
        <a asp-action="Contract" asp-controller="Admin"><i class="uk-margin-left fas fa-hand-holding-usd"></i>قرارداد ها</a>
    </li>
    <li @if (param == 100) { <text> class="active" </text> }>
        <a asp-action="Config" asp-controller="Admin"><i class="uk-margin-left fas fa-cogs"></i>تنظیمات سیستم</a>
    </li>
    <li class="uk-parent @if (param == 4 || param == 5) { <text>uk-open</text> }">
        <a><i class="uk-margin-left fas fa-money-bill"></i>هزینه ها</a>
        <ul class="uk-nav-sub">
            <li @if (param == 4) { <text> class="active" </text> }><a asp-action="Cost" asp-controller="Admin">جاری</a></li>
            <li @if (param == 5) { <text> class="active" </text> }><a asp-action="Payment" asp-controller="Admin">حقوق و مساعده</a></li>
        </ul>
    </li>
    <li class="uk-parent @if (param == 9 || param == 10 || param == 11 || param == 12 || param == 14 || param == 15) { <text>uk-open</text> }">
        <a><i class="uk-margin-left fas fa-clipboard-list"></i>گزارشات</a>
        <ul class="uk-nav-sub">
            <li @if (param == 9) { <text> class="active" </text> }><a asp-action="Detailed" asp-controller="Report">تفصیلی</a></li>
            <li @if (param == 10) { <text> class="active" </text> }><a asp-action="Cost" asp-controller="Report">هزینه های جاری</a></li>
            <li @if (param == 14) { <text> class="active" </text> }><a asp-action="Customer" asp-controller="Report">بر اساس مشتری</a></li>
            <li @if (param == 11) { <text> class="active" </text> }><a asp-action="Payment" asp-controller="Report">حقوق و مساعده کل</a></li>
            <li @if (param == 15) { <text> class="active" </text> }><a asp-action="PaymentByDriver" asp-controller="Report">حقوق و مساعده جزء</a></li>
            <li @if (param == 12) { <text> class="active" </text> }><a asp-action="DriverLoadFactor" asp-controller="Report">بارنامه های رانندگان</a></li>
        </ul>
    </li>
</ul>