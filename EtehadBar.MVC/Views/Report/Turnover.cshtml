@model IEnumerable<Turnover>

@{
    ViewData["pageId"] = 37;
    ViewData["Title"] = "سرمایه گذاران و شرکا";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int i = 1;
}

@section Links{
    <link href="~/lib/persian-date/persian-datepicker.min.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/lib/persian-date/persian-date.min.js"></script>
    <script src="~/lib/persian-date/persian-datepicker.min.js"></script>
    <script>
        let datePickerConfig = {
            initialValue: true,
            autoClose: true,
            timePicker: {
                enabled: false
            },
            format: 'YYYY/MM/DD',
            navigator: {
                enabled: true,
                scroll: {
                    "enabled": true
                },
                text: {
                    btnNextText: '>',
                    btnPrevText: '<'
                }
            },
            toolbox: {
                calendarSwitch: {
                    enabled: false
                }
            }
        };
        $(document).ready(function () {
            $('.startDate').persianDatepicker(datePickerConfig);
            $('.endDate').persianDatepicker(datePickerConfig);
        });
        $('#search-modal form').submit(function (e) {
            e.preventDefault();
            filter();
        });
        function filter() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Turnover", "Report")',
                data: $('#search-modal form').serialize(),
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger')
                },
                complete: function () {
                    preloader();
                    UIkit.modal('#search-modal').hide();
                }
            });
        }
    </script>
}
<style>
    .underline {
        text-decoration: underline;
    }
</style>

<div id="append">
    <div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
        <div class="uk-width-auto@m">
            <ul class="uk-breadcrumb">
                <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
                <li><span>@ViewData["Title"]</span></li>
            </ul>
        </div>
        <div class="uk-width-expand@m uk-flex uk-flex-left">
            <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        </div>
    </div>
    <div class="box uk-margin-small-bottom" style="padding:15px 30px">
        <h3 class="uk-text-center uk-margin-remove">گزارش سرمایه گذاران و شرکا از ابتدای @(new PersianDateTime(DateTime.Now).Year)</h3>
    </div>
    <div class="box uk-margin-small-bottom">
        @if (Model.Any())
        {
            <div class="uk-overflow-auto">
                <div class="uk-overflow-auto">
                    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                                <th>@Html.DisplayNameFor(model => model.TurnoverType)</th>
                                <th>@Html.DisplayNameFor(model => model.Date)</th>
                                <th>@Html.DisplayNameFor(model => model.Creditor)</th>
                                <th>@Html.DisplayNameFor(model => model.Debtor)</th>
                                <th>@Html.DisplayNameFor(model => model.Description)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="@item.RowId" data-row="@i" class="uk-text-center">
                                    <td class="sequence" draggable="true">@i</td>
                                    <td>@item.FullName</td>
                                    @if (item.TurnoverType == TurnoverType.Partner)
                                    {
                                        <td>شریک</td>
                                    }
                                    else
                                    {
                                        <td>سرمایه گذار</td>
                                    }
                                    <td>@(new PersianDateTime(item.Date).ToString("yyyy/MM/dd"))</td>
                                    <td>@item.Creditor.ToString("N0")</td>
                                    <td>@item.Debtor.ToString("N0")</td>
                                    <td class="uk-text-small">
                                        @if (string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span>---</span>
                                        }
                                        else
                                        {
                                            <pre>@Html.DisplayFor(modelItem => item.Description)</pre>
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="uk-margin-medium-top uk-margin-medium-bottom">
                <div class="uk-grid-large uk-text-center uk-child-width-1-1" uk-grid>
                    <div><i class="fas fa-4x fa-exclamation-triangle uk-text-danger"></i></div>
                    <div>
                        <h2>نتیجه ای یافت نشد.</h2>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="box" style="padding:15px 30px">
        <h3 class="uk-heading-divider uk-text-center">گزارش سرمایه گذاران و شرکا از ابتدای @(new PersianDateTime(DateTime.Now).Year)</h3>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع دریافت</div>
            <div>@Model.Sum(a => a.Debtor).ToString("N0") ریال</div>
        </div>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع پرداخت</div>
            <div>@Model.Sum(a => a.Creditor).ToString("N0") ریال</div>
        </div>
    </div>
</div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>

                <div class="uk-margin-top">
                    <label class="uk-form-label">از تاریخ</label>
                    <input name="startDate" class="startDate uk-input uk-border-rounded" dir="ltr" />
                </div>

                <div class="uk-margin-top">
                    <label class="uk-form-label">تا تاریخ</label>
                    <input name="endDate" class="endDate uk-input uk-border-rounded" dir="ltr" />
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="Turnover" asp-controller="Report" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>

