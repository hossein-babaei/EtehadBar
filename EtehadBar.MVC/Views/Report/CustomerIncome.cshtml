@model IEnumerable<CustomerIncome>

@{
    int i = 1;
    ViewData["pageId"] = 14;

    var customer = (Customer)ViewData["customer"];

    ViewData["Title"] = $"گزارش دریافتی های {customer.Name}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var calendars = (List<Calendar>)ViewData["calendars"];
    var latestCal = calendars.First();
}
@section Links{
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#search-modal select[name=calendarId]').select2({ width: '100%' });
        });
        $('#search-modal form').submit(function (e) {
            e.preventDefault();
            filter();
        });
        function filter() {
            $.ajax({
                    type: 'POST',
                    url: '@Url.Action("CustomerIncome", "Report")',
                    data: $('#search-modal form').serialize(),
                    dataType: 'html',
                    beforeSend: function () {
                        preloader();
                    },
                    success: function (r) {
                        $('#append').html(r);
                    },
                    error: function (e) {
                        uiAlert(e.responseText, 'danger')
                    },
                    complete: function () {
                        preloader();
                        UIkit.modal('#search-modal').hide();
                    }
                });
        }
    </script>
}
<style>
    .underline {
        text-decoration: underline;
    }
</style>
<div id="append">
    <div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
        <div class="uk-width-auto@m">
            <ul class="uk-breadcrumb">
                <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
                <li><span>@ViewData["Title"]</span></li>
            </ul>
        </div>
        <div class="uk-width-expand@m uk-flex uk-flex-left">
            @if (Model.Count() > 0)
            {
                <a asp-action="CustomerIncome" asp-controller="Print" asp-route-calendarId="@latestCal.Id" asp-route-id="@customer.Id" target="_blank" class="uk-button uk-button-secondary uk-margin-small-left" uk-icon="print"></a>
            }
            else
            {
                <button class="uk-button uk-button-default uk-margin-small-left" uk-icon="print" disabled></button>
            }
            <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        </div>
    </div>
    <div class="box uk-margin-small-bottom" style="padding:15px 30px">
        <h3 class="uk-text-center">گزارش دریافتی های @customer.Name در <span class="underline">@latestCal.Title</span></h3>
    </div>
    <div class="box uk-margin-small-bottom">
        @if (Model.Any())
        {
            <div class="uk-overflow-auto">
                <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                    <thead>
                        <tr>
                            <th width="50">ردیف</th>
                            <th>@Html.DisplayNameFor(model => model.Date)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Amount)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var pd = new PersianDateTime(item.Date);
                            <tr class="uk-text-center sm">
                                <td>@i</td>
                                <td>@pd.ToString("yyyy/MM/dd")</td>
                                <td>@item.Description</td>
                                <td>@item.Amount.ToString("N0")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="uk-margin-medium-top uk-margin-medium-bottom">
                <div class="uk-grid-large uk-text-center uk-child-width-1-1" uk-grid>
                    <div><i class="fas fa-4x fa-exclamation-triangle uk-text-danger"></i></div>
                    <div>
                        <h2>نتیجه ای یافت نشد.</h2>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="box" style="padding:15px 30px">
        <h3 class="uk-text-center">گزارش دریافتی های @customer.Name در <span class="underline">@latestCal.Title</span></h3>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">مجموع مبلغ دریافتی</div>
            <div>@Model.Sum(a => a.Amount).ToString("N0") ریال</div>
        </div>
    </div>
</div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>
                <input type="hidden" value="@customer.Id" name="id" />
                <label class="uk-form-label">تاریخ</label>
                <select name="calendarId">
                    @foreach (var item in calendars)
                    {
                        <option value="@item.Id">@item.Title</option>
                    }
                </select>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="CustomerIncome" asp-route-id="@customer.Id" asp-controller="Report" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>

