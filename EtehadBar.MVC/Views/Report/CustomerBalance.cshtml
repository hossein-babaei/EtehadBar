@model CustomerBalanceVM

@{
    ViewData["pageId"] = 14;
    var pdStartdate = new PersianDateTime(Model.StartDate);
    var pdEndDate = new PersianDateTime(Model.EndDate);
    ViewData["Title"] = $"گزارش مالی {Model.Customer.Name} از تاریخ {pdStartdate.ToString("yyyy/MM/dd")} الی {pdEndDate.ToString("yyyy/MM/dd")}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Links {
    <style>
        .underline {
            text-decoration: underline;
        }

        .uk-accordion-content table {
            border: 1px solid #e5e5e5;
            border-radius: 5px !important
        }

        .uk-accordion li {
            padding-bottom: 20px;
            border-bottom: 1px solid #ccc;
        }

            .uk-accordion li:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }
    </style>
}

<div id="append">
    <div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
        <div class="uk-width-auto@m">
            <ul class="uk-breadcrumb">
                <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
                <li><span>گزارش مالی @Model.Customer.Name</span></li>
            </ul>
        </div>
        <div class="uk-width-expand@m uk-flex uk-flex-left">
            @*@if (Model.Count() > 0)
            {
            <a asp-action="CustomerIncome" asp-controller="Excel" asp-route-calendarId="@latestCal.Id" asp-route-id="@customer.Id" class="uk-button uk-button-secondary uk-margin-small-left"><span class="fas fa-file-excel"></span></a>
            }
            else
            {
            <button class="uk-button uk-button-default uk-margin-small-left" disabled><span class="fas fa-file-excel"></span></button>
            }*@
            <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        </div>
    </div>
    <div class="box uk-margin-small-bottom" style="padding:15px 30px">
        <h3 class="uk-text-center uk-margin-remove">@ViewData["Title"]</h3>
    </div>
    <div class="box uk-margin-small-bottom">

        <div class="uk-overflow-auto">
            <ul uk-accordion="multiple: true">
                @foreach (var item in Model.Details)
                {
                    int i = 1;
                    <li class="uk-open">
                        <a class="uk-accordion-title" href="#">
                            @if (item.CalendarId == 0)
                            {
                                <span>دوره قبل از @pdStartdate.ToString("yyyy/MM/dd")</span>
                            }
                            else
                            {
                                <span>@Model.Calendars.Single(a => a.Id.Equals(item.CalendarId)).Title</span>
                            }
                        </a>
                        <div class="uk-accordion-content">
                            <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-flex-middle" uk-grid>
                                <div class="uk-width-2-3@m">
                                    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                                        <thead>
                                            <tr>
                                                <th width="50">ردیف</th>
                                                <th>تاریخ</th>
                                                <th>شعبه</th>
                                                <th>مبلغ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (item.CustomerIncomes.Any())
                                            {
                                                foreach (var ci in item.CustomerIncomes)
                                                {
                                                    var pd = new PersianDateTime(ci.Date);
                                                    <tr class="uk-text-center sm">
                                                        <td>@i</td>
                                                        <td>@pd.ToString("yyyy/MM/dd")</td>
                                                        <td>@ci.BankName</td>
                                                        <td>@ci.Amount.ToString("N0")</td>
                                                    </tr>
                                                    i++;
                                                }
                                                <tr class="uk-text-center sm">
                                                    <td colspan="3">جمع</td>
                                                    <td>@item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="uk-text-center sm">
                                                    <td colspan="4">
                                                        دریافتی وجود ندارد
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="uk-width-1-3@m">
                                    <div class="uk-grid-medium uk-child-width-1-1" uk-grid>
                                        <div>تعداد زونکن ها: @item.AccountBookQuantity عدد</div>
                                        <div>جمع کل زونکن ها: @item.AccountBookLoadFactorsSum.ToString("N0") ریال</div>
                                    </div>
                                </div>
                                <div><hr /></div>
                                <div>
                                    <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-child-width-1-2@s uk-text-center" uk-grid>
                                        <div>
                                            <b>دریافتی: @item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</b>
                                        </div>
                                        <div>
                                            <b>جمع فاکتور: @item.AccountBookLoadFactorsSum.ToString("N0") ریال</b>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>

        </div>
    </div>
    <div class="box" style="padding:15px 30px">
        <h3 class="uk-text-center">گزارش دریافتی های @Model.Customer.Name در <span class="underline uk-text-left" dir="ltr">@pdEndDate.ToString("yyyy/MM/dd - HH:mm:ss")</span></h3>
        <hr />
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع مبلغ دریافتی</div>
            <div>@Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount)).ToString("N0") ریال</div>
        </div>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع مبلغ فاکتور ها</div>
            <div>@Model.Details.Sum(a => a.AccountBookLoadFactorsSum).ToString("N0") ریال</div>
        </div>
    </div>
</div>

