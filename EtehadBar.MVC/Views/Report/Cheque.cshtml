@model IEnumerable<Cheque>

@{
    ViewData["pageId"] = 45;
    ViewData["Title"] = "چک های دریافتی";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var customers = (List<Customer>)ViewData["Customers"];
    var previousChequeRemainsSum = (double)ViewData["PreviousChequeRemainsSum"];
    int i = 1;
}

@section Links{
    <link href="~/lib/persian-date/persian-datepicker.min.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/lib/persian-date/persian-date.min.js"></script>
    <script src="~/lib/persian-date/persian-datepicker.min.js"></script>
    <script>
        let datePickerConfig = {
            initialValue: true,
            autoClose: true,
            timePicker: {
                enabled: false
            },
            format: 'YYYY/MM/DD',
            navigator: {
                enabled: true,
                scroll: {
                    "enabled": true
                },
                text: {
                    btnNextText: '>',
                    btnPrevText: '<'
                }
            },
            toolbox: {
                calendarSwitch: {
                    enabled: false
                }
            }
        };

        $(document).ready(function () {
            $('.startDate').persianDatepicker(datePickerConfig);
            $('.endDate').persianDatepicker(datePickerConfig);
        });

        $('#search-modal form').submit(function (e) {
            e.preventDefault();
            filter();
        });

        function filter() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Cheque", "Report")',
                data: $('#search-modal form').serialize(),
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger')
                },
                complete: function () {
                    preloader();
                    UIkit.modal('#search-modal').hide();
                }
            });
        }
    </script>
}

<style>
    .underline {
    text-decoration: underline;
    }
</style>

<div id="append">
    <div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
        <div class="uk-width-auto@m">
            <ul class="uk-breadcrumb">
                <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
                <li><span>@ViewData["Title"]</span></li>
            </ul>
        </div>
        <div class="uk-width-expand@m uk-flex uk-flex-left">
            <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        </div>
    </div>
    <div class="box uk-margin-small-bottom" style="padding:15px 30px">
        <h3 class="uk-text-center uk-margin-remove">گزارش چک های دریافتی از ابتدای @(new PersianDateTime(DateTime.Now).Year)</h3>
    </div>
    <div class="box uk-margin-small-bottom">
        @if (Model.Any())
        {
            <div class="uk-overflow-auto">
                <div class="uk-overflow-auto">
                    <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>@Html.DisplayNameFor(model => model.Date)</th>
                                <th>@Html.DisplayNameFor(model => model.Amount)</th>
                                <th>@Html.DisplayNameFor(model => model.CustomerId)</th>
                                <th>@Html.DisplayNameFor(model => model.Issuer)</th>
                                <th>@Html.DisplayNameFor(model => model.Number)</th>
                                <th>@Html.DisplayNameFor(model => model.BankOfOrigin)</th>
                                <th>@Html.DisplayNameFor(model => model.RecieveDate)</th>
                                <th>@Html.DisplayNameFor(model => model.SendToBankName)</th>
                                <th>@Html.DisplayNameFor(model => model.SendToBankDate)</th>
                                <th>@Html.DisplayNameFor(model => model.Status)</th>
                                <th>@Html.DisplayNameFor(model => model.PassDate)</th>
                                <th>@Html.DisplayNameFor(model => model.Description)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var pd = new PersianDateTime(item.Date);
                                var persianRecieveDate = new PersianDateTime(item.RecieveDate);
                                var persianSendToBankDate = new PersianDateTime(item.SendToBankDate ?? DateTime.Now);
                                var persianPassDate = new PersianDateTime(item.PassDate ?? DateTime.Now);

                                <tr class="uk-text-center sm">
                                    <td>@i</td>
                                    <td>@pd.ToString("yyyy/MM/dd")</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>@item.Customer.Name</td>
                                    <td>@item.Issuer</td>
                                    <td>@item.Number</td>
                                    <td>@item.BankOfOrigin</td>
                                    <td>@persianRecieveDate.ToString("yyyy/MM/dd")</td>
                                    <td>@item.SendToBankName</td>
                                    <td>@(item.SendToBankDate.HasValue ? persianSendToBankDate.ToString("yyyy/MM/dd") : "---")</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case (ChequeStatus.NotPassed):
                                                <span class="uk-text-primary">پاس نشده</span>
                                                break;
                                            case (ChequeStatus.Rejected):
                                                <span class="uk-text-danger">برگشت خورده</span>
                                                break;
                                            case (ChequeStatus.Passed):
                                                <span class="uk-text-success">پاس شده</span>
                                                break;
                                            default:
                                                <span class="uk-text-primary">پاس نشده</span>
                                                break;
                                        }
                                    </td>
                                    <td>@(item.PassDate.HasValue ? persianPassDate.ToString("yyyy/MM/dd") : "---")</td>
                                    <td class="uk-text-small">@(string.IsNullOrWhiteSpace(item.Description) ? "---" : item.Description)</td>
                                    </tr>
                                    i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="uk-margin-medium-top uk-margin-medium-bottom">
                <div class="uk-grid-large uk-text-center uk-child-width-1-1" uk-grid>
                    <div><i class="fas fa-4x fa-exclamation-triangle uk-text-danger"></i></div>
                    <div>
                        <h2>نتیجه ای یافت نشد.</h2>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="box" style="padding:15px 30px">
        <h3 class="uk-heading-divider uk-text-center">گزارش چک های دریافتی از ابتدای @(new PersianDateTime(DateTime.Now).Year)</h3>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع کل چکهای دریافتی از ابتدای @(new PersianDateTime(DateTime.Now).Year)</div>
            <div>@Model.Sum(a => a.Amount).ToString("N0") ریال</div>
        </div>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع چکهای پاس شده</div>
            <div>@Model.Where(a => a.Status.Equals(ChequeStatus.Passed)).Sum(a => a.Amount).ToString("N0") ریال</div>
        </div>
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-expand" uk-leader="fill: .">جمع چکهای پاس نشده</div>
            <div>@Model.Where(a => a.Status.Equals(ChequeStatus.NotPassed) || a.Status.Equals(ChequeStatus.Rejected)).Sum(a => a.Amount).ToString("N0") ریال</div>
        </div>
        @if (previousChequeRemainsSum > 0)
        {
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">جمع چکهای پاس نشده مانده از قبل</div>
                <div>@previousChequeRemainsSum.ToString("N0") ریال</div>
            </div>
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">جمع کل چک های پاس نشده</div>
                <div>@((previousChequeRemainsSum + Model.Where(a => a.Status.Equals(ChequeStatus.NotPassed) || a.Status.Equals(ChequeStatus.Rejected)).Sum(a => a.Amount)).ToString("N0")) ریال</div>
            </div>
        }
    </div>
</div>
<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">جستجو</h2>
        </div>
        <div class="uk-modal-body">
            <form>

                <div class="uk-margin-top">
                    <label class="uk-form-label">از تاریخ</label>
                    <input name="startDate" class="startDate uk-input uk-border-rounded" dir="ltr" />
                </div>

                <div class="uk-margin-top">
                    <label class="uk-form-label">تا تاریخ</label>
                    <input name="endDate" class="endDate uk-input uk-border-rounded" dir="ltr" />
                </div>

                <div>
                    <label class="uk-form-label">بر اساس مشتری</label>
                    <select class="uk-select uk-border-rounded" id="customerId" name="customerId">
                        <option value="">همه</option>
                        @foreach (var item in customers)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="uk-form-label">بر اساس وضعیت</label>
                    <select class="uk-select uk-border-rounded" id="status" name="chequeStatus">
                        <option value=""></option>
                        <option value="@((int)ChequeStatus.NotPassed)">پاس نشده</option>
                        <option value="@((int)ChequeStatus.Passed)">پاس شده</option>
                        <option value="@((int)ChequeStatus.Rejected)">برگشت خورده</option>
                    </select>
                </div>
            </form>
            <div class="uk-margin-top uk-text-center">
                <a asp-action="Turnover" asp-controller="Report" class="uk-button uk-button-text">ریست کردن نتایج</a>
            </div>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <button class="uk-button uk-button-primary" type="button" onclick="filter()">مشاهده نتایج</button>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>