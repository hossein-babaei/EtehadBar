@model IEnumerable<PaymentVM>

@{
    int i = 1;

    var calendar = (Calendar)ViewData["calendar"];

    var amount = Model.Sum(a => a.Amount);
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        @if (Model.Count() > 0)
        {
            <a asp-action="Payment" asp-controller="Excel" asp-route-calendarId="@calendar.Id" asp-route-type="@ViewData["type"].ToString()" asp-route-vehicleId="@ViewData["vehicleId"].ToString()" class="uk-button uk-button-secondary uk-margin-small-left"><span class="fas fa-file-excel"></span></a>
        }
        else
        {
            <button class="uk-button uk-button-default uk-margin-small-left" disabled><span class="fas fa-file-excel"></span></button>
        }
        <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
    </div>
</div>
<div class="box uk-margin-small-bottom" style="padding:15px 30px">
    <h3 class="uk-text-center">گزارش حقوق و مساعده پرداختی در <span class="underline">@calendar.Title</span></h3>
</div>
<div class="box uk-margin-small-bottom">
    @if (Model.Any())
    {
        <div class="uk-overflow-auto">
            <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                <thead>
                    <tr>
                        <th width="50">ردیف</th>
                        <th>@Html.DisplayNameFor(model => model.Date)</th>
                        <th>@Html.DisplayNameFor(model => model.PaymentType)</th>
                        <th>@Html.DisplayNameFor(model => model.Description)</th>
                        <th>@Html.DisplayNameFor(model => model.Amount)</th>
                        <th>@Html.DisplayNameFor(model => model.AdminName)</th>
                        <th>@Html.DisplayNameFor(model => model.VehicleId)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string type = item.PaymentType switch
                        {
                            PaymentType.AdvanceMoney => "مساعده",
                            PaymentType.Salary => "حقوق",
                            _ => ""
                        };

                        var pd = new PersianDateTime(item.Date);

                        <tr class="uk-text-center samim xs">
                            <td>
                                @i
                            </td>
                            <td>@pd.ToString("yyyy/MM/dd")</td>
                            <td>@type</td>
                            <td>@item.Description</td>
                            <td>@item.Amount.ToString("N0")</td>
                            <td>@item.AdminName</td>
                            <td>@item.Vehicle</td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="uk-margin-medium-top uk-margin-medium-bottom">
            <div class="uk-grid-large uk-text-center uk-child-width-1-1" uk-grid>
                <div><i class="fas fa-4x fa-exclamation-triangle uk-text-danger"></i></div>
                <div>
                    <h2>نتیجه ای یافت نشد.</h2>
                </div>
            </div>
        </div>
    }
</div>
<div class="box" style="padding:15px 30px">
    <h3 class="uk-heading-divider uk-text-center">گزارش حقوق و مساعده پرداختی در <span class="underline">@calendar.Title</span></h3>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">تعداد مساعده پرداختی</div>
        <div>@Model.Count(a => a.PaymentType.Equals((byte)PaymentType.AdvanceMoney)) عدد</div>
    </div>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">تعداد حقوق پرداختی</div>
        <div>@Model.Count(a => a.PaymentType.Equals((byte)PaymentType.Salary)) عدد</div>
    </div>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">تعداد کل</div>
        <div>@Model.Count() عدد</div>
    </div>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">مجموع مبلغ مساعده پرداختی</div>
        <div>@Model.Where(a => a.PaymentType.Equals((byte)PaymentType.AdvanceMoney)).Sum(a => a.Amount).ToString("N0") تومان</div>
    </div>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">مجموع مبلغ حقوق پرداختی</div>
        <div>@Model.Where(a => a.PaymentType.Equals((byte)PaymentType.Salary)).Sum(a => a.Amount).ToString("N0") تومان</div>
    </div>
    <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand" uk-leader="fill: .">جمع کل</div>
        <div>@amount.ToString("N0") تومان</div>
    </div>
</div>