@model CustomerBalanceVM

@{
    string title = $"گزارش مالی {Model.Customer.Name} به تاریخ {new PersianDateTime(DateTime.Now).ToString("yyyy/MM/dd")}";
    int days = 45;
    if (Model.Customer.CustomerType == CustomerType.SaipaPlasco)
        days = 60;
}

<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>گزارش مالی @Model.Customer.Name</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        @*@if (Model.Count() > 0)
        {
        <a asp-action="CustomerIncome" asp-controller="Excel" asp-route-calendarId="@latestCal.Id" asp-route-id="@customer.Id" class="uk-button uk-button-secondary uk-margin-small-left"><span class="fas fa-file-excel"></span></a>
        }
        else
        {
        <button class="uk-button uk-button-default uk-margin-small-left" disabled><span class="fas fa-file-excel"></span></button>
        }*@
        <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        @*@if (Model.Type)
        {
        <a class="uk-button uk-button-primary" asp-action="CustomerBalance" asp-route-contractId="@Model.Contract.Id" asp-route-type="false">مشاهده خلاصه</a>
        }
        else
        {
        <a class="uk-button uk-button-primary" asp-action="CustomerBalance" asp-route-contractId="@Model.Contract.Id" asp-route-type="true">مشاهده همه</a>
        }*@
    </div>
</div>
<div class="box uk-margin-small-bottom" style="padding:15px 30px">
    <h3 class="uk-text-center uk-margin-remove">@ViewData["Title"]</h3>
</div>

<div class="uk-grid-small uk-child-width-1-1" uk-grid>
    @foreach (var item in Model.Details)
    {
        int i = 1;
        <div>
            <div class="box">
                <h4 class="uk-heading-line uk-text-center">
                    @if (item.CalendarId == -1)
                    {
                        <span>دوره قبل از @(new PersianDateTime(Model.StartDate).ToString("yyyy/MM/dd"))</span>
                    }
                    //else if (item.CalendarId == 0)
                    //{
                    //    <span>دوره بعد از اتمام قرارداد@(new PersianDateTime(Model.Contract.EndDate).ToString("yyyy/MM/dd"))</span>
                    //}
                    else
                    {
                        <span>@Model.Calendars.Single(a => a.Id.Equals(item.CalendarId)).Title</span>
                    }
                </h4>
                <div class="uk-accordion-content">
                    <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-flex-middle" uk-grid>
                        <div class="uk-width-1-2@m">
                            @if (item.CustomerIncomes.Any())
                            {
                                <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                                    <caption>جدول دریافتی</caption>
                                    <thead>
                                        <tr>
                                            <th width="50">ردیف</th>
                                            <th>تاریخ</th>
                                            <th>شعبه</th>
                                            <th>مبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ci in item.CustomerIncomes)
                                        {
                                            var pd = new PersianDateTime(ci.Date);
                                            <tr class="uk-text-center sm">
                                                <td>@i</td>
                                                <td>@pd.ToString("yyyy/MM/dd")</td>
                                                <td>@ci.BankName</td>
                                                <td>@ci.Amount.ToString("N0")</td>
                                            </tr>
                                            i++;
                                        }
                                        <tr class="uk-text-center sm">
                                            <td colspan="3">جمع</td>
                                            <td>@item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="uk-grid-medium uk-text-center uk-child-width-1-1 uk-margin-small-bottom" uk-grid>
                                    <div><i class="fas fa-3x fa-exclamation-triangle uk-text-danger"></i></div>
                                    <div>
                                        <h4>دریافتی وجود ندارد.</h4>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="uk-width-1-2@m">
                            @if (item.CustomerFactors.Any())
                            {
                                <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                                    <caption>جدول فاکتور ها</caption>
                                    <thead>
                                        <tr>
                                            <th width="50">ردیف</th>
                                            <th>تاریخ</th>
                                            <th>شماره فاکتور</th>
                                            <th>مبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cf in item.CustomerFactors)
                                        {
                                            var pd = new PersianDateTime(cf.Date);
                                            <tr class="uk-text-center sm">
                                                <td>@i</td>
                                                <td>@pd.ToString("yyyy/MM/dd")</td>
                                                <td>@cf.FactorNumber</td>
                                                <td>@cf.Amount.ToString("N0")</td>
                                            </tr>
                                            i++;
                                        }
                                        <tr class="uk-text-center sm">
                                            <td colspan="3">جمع</td>
                                            <td>@item.CustomerFactors.Sum(a => a.Amount).ToString("N0") ریال</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="uk-grid-medium uk-text-center uk-child-width-1-1 uk-margin-small-bottom" uk-grid>
                                    <div><i class="fas fa-3x fa-exclamation-triangle uk-text-danger"></i></div>
                                    <div>
                                        <h4>فاکتوری ارائه نشده است.</h4>
                                    </div>
                                </div>
                            }
                        </div>
                        <div><hr /></div>
                        <div>
                            <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-child-width-1-2@s uk-text-center" uk-grid>
                                <div>
                                    <b>دریافتی: @item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</b>
                                </div>
                                <div>
                                    <b>جمع فاکتور: @item.CustomerFactors.Sum(a => a.Amount).ToString("N0") ریال</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div>
        <div class="box" style="padding:15px 30px">
            <h3 class="uk-text-center">خلاصه گزارش مالی @Model.Customer.Name در <span class="underline uk-text-left" dir="ltr">@(new PersianDateTime(DateTime.Now).ToString("yyyy/MM/dd"))</span></h3>
            <hr />
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">جمع مبلغ دریافتی</div>
                <div>@Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount)).ToString("N0") ریال</div>
            </div>
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">جمع مبلغ فاکتور ها (صفر روزه)</div>
                <div>@Model.Details.Sum(a => a.CustomerFactors.Sum(a => a.Amount)).ToString("N0") ریال</div>
            </div>
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">مانده (صفر روزه)</div>
                <div>@((Model.Details.Sum(a => a.CustomerFactors.Sum(a => a.Amount)) - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0")) ریال</div>
            </div>
            @{
                var daysSum = Model.Details.Sum(a => a.CustomerFactors.Where(a => a.Date <= DateTime.Now.AddDays(-days)).Sum(a => a.Amount));
            }
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">جمع مبلغ فاکتور ها (@days روزه)</div>
                <div>@daysSum.ToString("N0") ریال</div>
            </div>
            <div class="uk-grid-small" uk-grid>
                <div class="uk-width-expand" uk-leader="fill: .">مانده (@days روزه)</div>
                <div>@((daysSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0")) ریال</div>
            </div>
        </div>
    </div>
</div>