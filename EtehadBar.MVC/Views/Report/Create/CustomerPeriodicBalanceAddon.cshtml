@model CreateCustomerPeriodicBalanceAddonVM
<div class="uk-modal-dialog">
    <div class="uk-modal-header uk-light">
        <h2 class="uk-modal-title">افزودن جدید</h2>
    </div>
    <div class="uk-modal-body">
        <form id="create-form" asp-action="CreateCustomerPeriodicBalanceAddon" method="post">
            <div asp-validation-summary="ModelOnly" class="uk-text-danger"></div>
            <input asp-for="CustomerPeriodicBalanceSummaryId" value="@((long)ViewData["Id"])" type="hidden" />
            <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                <div>
                    <label asp-for="Amount" class="uk-form-label"></label>
                    <input asp-for="Amount" class="uk-input uk-border-rounded format-number" />
                    <span asp-validation-for="Amount" class="uk-text-danger"></span>
                </div>
                <div>
                    <label asp-for="Title" class="uk-form-label"></label>
                    <input asp-for="Title" class="uk-input uk-border-rounded" />
                    <span asp-validation-for="Title" class="uk-text-danger"></span>
                </div>
                <div>
                    <h5 class="uk-text-bold">تاریخ</h5>
                    <div class="uk-grid-small uk-child-width-1-3" uk-grid>
                        <div>
                            <label asp-for="Day" class="uk-form-label"></label>
                            <select asp-for="Day" class="uk-select uk-border-rounded">
                                @for (int i = 1; i < 32; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            <span asp-validation-for="Day" class="uk-text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="Month" class="uk-form-label"></label>
                            <select asp-for="Month" class="uk-select uk-border-rounded">
                                @for (int i = 1; i < 13; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            <span asp-validation-for="Month" class="uk-text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="Year" class="uk-form-label"></label>
                            <select asp-for="Year" class="uk-select uk-border-rounded">
                                @for (int i = 1398; i < 1411; i++)
                                {
                                    <!option value="@i" @if (new PersianDateTime(DateTime.Now).Year == i) { <text> selected</text> }>@i</!option>
                                }
                            </select>
                            <span asp-validation-for="Year" class="uk-text-danger"></span>
                        </div>
                    </div>
                </div>
                <div>
                    <label asp-for="AddonType" class="uk-form-label"></label>
                    <select asp-for="AddonType" class="uk-select uk-border-rounded">
                        <option value="@((int)CustomerPeriodicBalanceAddonType.Mofasa)">مفاصاحساب</option>
                        <option value="@((int)CustomerPeriodicBalanceAddonType.Damage)">خسارت</option>
                        <option value="@((int)CustomerPeriodicBalanceAddonType.Food)">غذا</option>
                        <option value="@((int)CustomerPeriodicBalanceAddonType.Other)">سایر</option>
                    </select>
                    <span asp-validation-for="AddonType" class="uk-text-danger"></span>
                </div>
                <div>
                    <div class="uk-grid-small uk-child-width-auto uk-grid">
                        <label asp-for="IsPositive"></label>
                        <label><input class="uk-radio" type="radio" asp-for="IsPositive" value="true"> اضافه</label>
                        <label><input class="uk-radio" type="radio" asp-for="IsPositive" value="false" checked> کسر</label>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="uk-modal-footer uk-text-center">
        <button class="uk-button uk-button-primary" type="button" onclick="submitForm('#create-form')">ثبت اطلاعات</button>
        <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
    </div>
</div>