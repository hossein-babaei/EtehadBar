@model IEnumerable<Customer>

@{
    int i = 1;
    ViewData["pageId"] = 14;
    ViewData["Title"] = "گزارش بارنامه بر اساس مشتری";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var calendars = (List<Calendar>)ViewData["calendars"];
    var latestCal = calendars.First();
}
@section Scripts{
    <script>
        let vehicleList = [],
            contractList = [];
        function submitActivityByCustomerForm(submitButton, isFreeDriverFee) {
            let form = $(submitButton).parent().parent().parent().parent().find('form');
            form.find('input[name=isFreeDriverFee]').val(isFreeDriverFee);
            form.submit();
        }
        function getGlobalDetailedReport(submitButton) {
            let form = $(submitButton).parent().parent().parent().parent().find('form');
            let customerId = form.find('input[name=customerId]').val(),
                calendarId = form.find('select').val();

            window.open(`/excel/global-detailed-report?customerId=${customerId}&calendarId=${calendarId}`, '_blank');
        }
        function showFormByCalendar(id, type) {
            //if (vehicleList.length == 0) {
            //    $.ajax({
            //        type: 'POST',
            //        url: '@Url.Action("GetVehicleListJson", "Report")',
            //        data: {},
            //        dataType: 'json',
            //        async: false,
            //        beforeSend: function () {
            //            preloader();
            //        },
            //        success: function (r) {
            //            vehicleList = r;
            //        },
            //        error: function (e) {
            //            uiAlert(e.responseText, 'danger')
            //        },
            //        complete: function () {
            //            preloader();
            //        }
            //    });
            //}

            //let options = '<option value="0">همه راننده ها</option>';
            //$.each(vehicleList, (i, v) => {
            //    options += `<option value="${v.id}">${v.number} (${v.type})</option>`;
            //});
            //$('#modal select[name=vehicleId]').html(options);
            $('#modal-append').html('');

            $('#modal input[name=customerId]').val(id);

            $('#modal select[name=calendarId]').select2({ width: '100%' });
            $('#modal select[name=exportType]').select2({ width: '100%' });
            //$('#modal select[name=vehicleId]').select2({ width: '100%' });
            UIkit.modal('#modal').show();
        }
        function showFormByCustomer(id) {
            const modalId = '#activity-modal';
            $(`${modalId} input[name=customerId]`).val(id);

            $(`${modalId} select[name=calendarId]`).select2({ width: '100%' });
            UIkit.modal(modalId).show();
        }
        function showFormByAccountBook(id, type) {
            const modal = $('#account-book-modal');
            let options = '';

            preloader();
            $.post('@Url.Action("GetAccountBookListByCustomerId", "Admin")', { 'customerId': id }, (r) => {
                $.each(r, (i, v) => {
                    options += `<option value="${v.id}">${v.number} (${v.status})</option>`;
                });
                modal.find('select[name="accountBookId"]').html(options);
            }, 'json').then(() => { preloader() });

            modal.find('select[name=accountBookId]').select2({ width: '100%' });
            modal.find('select[name=exportType]').select2({ width: '100%' });
            modal.find('input[name=customerId]').val(id);
            UIkit.modal('#account-book-modal').show();
        }
        function submitForm(submitButton, hasPayment, isFreeDriverFee) {
            let form = $(submitButton).parent().parent().find('form');
            form.find('input[name=hasPayment]').val(hasPayment);
            form.find('input[name=isFreeDriverFee]').val(isFreeDriverFee);
            form.submit();
        }
        function submitCustomerSeparateRouteReport() {
            let calendarId = $('#activity-modal select').val();
            let customerId = $('#activity-modal input[name=customerId]').val();

            window.open(`/report/customer-separate-route?customerId=${customerId}&calendarId=${calendarId}`, '_blank');
        }
        function submitCustomerSeparateRouteIncomeReport() {
            let calendarId = $('#activity-modal select').val();
            let customerId = $('#activity-modal input[name=customerId]').val();

            window.open(`/report/customer-separate-route-income?customerId=${customerId}&calendarId=${calendarId}`, '_blank');
        }
        function showActivityList(id, type) {
            $('#modal-append').html('');

            $('#activity-list-modal input[name=customerId]').val(id);

            $('#activity-list-modal select[name=calendarId]').select2({ width: '100%' });
            //$('#modal select[name=vehicleId]').select2({ width: '100%' });
            UIkit.modal('#activity-list-modal').show();
        }
        function showFullActivity(id) {
            const modalId = '#full-activity-list-modal';
            $(`${modalId} input[name=customerId]`).val(id);

            $(`${modalId} select[name=calendarId]`).select2({ width: '100%' });
            UIkit.modal(modalId).show();
        }
        function submitFullActivity(type) {
            const modalId = '#full-activity-list-modal';
            $(`${modalId} input[name=type]`).val(type);
            $(`${modalId} form`).submit();
        }
        function goToDriverBalance() {
            var customerId = $('#activity-list-modal input[name=customerId]').val();
            var calendarId = $('#activity-list-modal select[name=calendarId]').val();
            window.open(`/admin/vehicle-balance-by-customer?customerId=${customerId}&calendarId=${calendarId}`, '_blank');
        }
        function showContracts(customerId) {
            if (contractList.length == 0) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetContractsJson", "Admin")',
                    data: {},
                    dataType: 'json',
                    async: false,
                    beforeSend: function () {
                        preloader();
                    },
                    success: function (r) {
                        contractList = r;
                    },
                    error: function (e) {
                        uiAlert(e.responseText, 'danger')
                    },
                    complete: function () {
                        preloader();
                    }
                });
            }

            const modalId = '#contract-modal';
            $(`${modalId} select[name=contractId]`).select2({ width: '100%' });
            let thisCustomerContracts = contractList.filter(a => a.customerId == customerId);

            let options = '';
            $.each(thisCustomerContracts, (i, v) => {
                options += `<option value="${v.id}">${v.number}</option>`;
            })
            $(`${modalId} select[name=contractId]`).html(options);

            UIkit.modal(modalId).show();
        }
    </script>
}
<div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
    <div class="uk-width-auto@m">
        <ul class="uk-breadcrumb">
            <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
            <li><span>@ViewData["Title"]</span></li>
        </ul>
    </div>
    <div class="uk-width-expand@m uk-flex uk-flex-left">
        <a class="uk-button uk-button-primary" asp-action="Customer" asp-controller="Admin">مدیریت مشتریان</a>
    </div>
</div>
<div id="append" class="box">
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>گزارشات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="uk-text-center sm">
                        <td>@i</td>
                        <td>@item.Name</td>
                        @if (item.Status)
                        {
                            <td class="uk-text-bold uk-text-success">فعال</td>
                        }
                        else
                        {
                            <td class="uk-text-bold uk-text-danger">غیر فعال</td>
                        }
                        <td>
                            <button class="uk-button uk-button-default" type="button"><i uk-icon="chevron-down"></i></button>
                            <div uk-dropdown="pos: bottom-center; mode: click">
                                <ul class="uk-nav uk-dropdown-nav">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="uk-nav-header">دریافتی</li>
                                        <li>
                                            <a asp-action="CustomerBalance" asp-route-customerId="@item.Id">مالی</a>
                                        </li>
                                        <li>
                                            <a asp-action="CustomerIncome" asp-route-id="@item.Id">دریافتی</a>
                                        </li>
                                        <li>
                                            <a asp-action="CustomerPeriodicBalanceSummary" asp-route-customerId="@item.Id">خلاصه مالی دوره ای</a>
                                        </li>
                                    }
                                    <li class="uk-nav-header">گزارشات</li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                                    {
                                        <li>
                                            <a onclick="showFormByCustomer(@item.Id)">عملکرد تفصیلی</a>
                                        </li>
                                        <li>
                                            <a onclick="showActivityList(@item.Id)">عملکرد مالی راننده</a>
                                        </li>
                                        <li>
                                            <a onclick="showFullActivity(@item.Id)">عملکرد تکمیلی</a>
                                        </li>
                                    }
                                    <li class="uk-nav-divider"></li>
                                    <li>
                                        <a onclick="showFormByCalendar(@item.Id, @((byte)item.CustomerType))">بر اساس تقویم کاری</a>
                                    </li>
                                    <li>
                                        <a onclick="showFormByAccountBook(@item.Id, @((byte)item.CustomerType))">بر اساس صورت وضعیت</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
<div id="activity-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">خروجی عملکرد خودرو بر اساس مشتری</h2>
        </div>
        <div class="uk-modal-body">
            <form method="post" action="@Url.Action("VehicleActivityByCustomer", "Excel")" autocomplete="off">
                <input type="hidden" name="customerId" value="" />
                <input type="hidden" name="isFreeDriverFee" value="" />
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">تاریخ</label>
                        <select name="calendarId">
                            @foreach (var item in calendars)
                            {
                                <!option value="@item.Id" @if (latestCal.Id.Equals(item)) {
                            <text> selected="selected" </text>
                            }>@item.Title</!option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <div class="uk-grid-small uk-child-width-auto uk-flex-center" uk-grid>
                <div>
                    <a class="uk-button uk-button-primary" onclick="getGlobalDetailedReport(this)">یکپارچه</a>
                </div>
                <div>
                    <a class="uk-button uk-button-primary" onclick="submitActivityByCustomerForm(this, 'False')">قراردادی</a>
                </div>
                <div>
                    <a class="uk-button uk-button-primary" onclick="submitActivityByCustomerForm(this, 'True')">موردی ها</a>
                </div>
                <div>
                    <a class="uk-button uk-button-primary" onclick="submitCustomerSeparateRouteReport()">پرداختی تفکیکی</a>
                </div>
                <div>
                    <a class="uk-button uk-button-primary" onclick="submitCustomerSeparateRouteIncomeReport()">دریافتی تفکیکی</a>
                </div>
                <div>
                    <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">خروجی بر اساس تقویم کاری</h2>
        </div>
        <div class="uk-modal-body">
            <form method="post" action="@Url.Action("Customer", "Excel")" autocomplete="off">
                <input type="hidden" name="customerId" value="" />
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">تاریخ</label>
                        <select name="calendarId">
                            @foreach (var item in calendars)
                            {
                                <!option value="@item.Id" @if (latestCal.Id.Equals(item)) {
                            <text> selected="selected" </text>
                            }>@item.Title</!option>
                            }
                        </select>
                    </div>
                    @*<div>
                    <label class="uk-form-label">خودرو</label>
                    <select name="vehicleId"></select>
                    </div>*@
                    @if (User.IsInRole("Admin") || User.IsInRole("User") || User.IsInRole("Milad"))
                    {
                        <div>
                            <label class="uk-form-label">نوع خروجی</label>
                            <select name="exportType">
                                @if (User.IsInRole("Admin") || User.IsInRole("Milad"))
                                {
                                    <option value="@((int)ExcelExportType.WithoutPrice)">بدون نرخ</option>
                                    <option value="@((int)ExcelExportType.WithAllPrices)">با تمامی نرخ ها</option>
                                    <option value="@((int)ExcelExportType.OnlyReceivingPrice)">با نرخ دریافتی</option>
                                    <option value="@((int)ExcelExportType.OnlyDriverPrice)">با نرخ پرداختی</option>
                                }
                                else
                                {
                                    <option value="@((int)ExcelExportType.WithoutPrice)">بدون نرخ</option>
                                    <option value="@((int)ExcelExportType.OnlyDriverPrice)">با نرخ پرداختی</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input name="exportType" type="hidden" value="@((int)ExcelExportType.OnlyReceivingPrice)" />
                    }
                    <div id="modal-append"></div>
                </div>
            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary uk-margin-small-left" onclick="submitForm(this)">مشاهده</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
