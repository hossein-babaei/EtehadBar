            <a class="uk-button uk-button-primary uk-margin-small-left" onclick="submitForm(this)">مشاهده</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="activity-list-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">خروجی بر اساس تقویم کاری</h2>
        </div>
        <div class="uk-modal-body">
            <form method="post" action="@Url.Action("ActivityList", "Excel")" autocomplete="off">
                <input type="hidden" name="customerId" value="" />
                <input type="hidden" name="hasPayment" value="" />
                <input type="hidden" name="isFreeDriverFee" value="" />
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">تاریخ</label>
                        <select name="calendarId">
                            @foreach (var item in calendars)
                            {
                                <!option value="@item.Id" @if (latestCal.Id.Equals(item)) {
                            <text> selected="selected" </text>
                            }>@item.Title</!option>
                            }
                        </select>
                    </div>
                    <div id="modal-append"></div>
                </div>

            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="goToDriverBalance()">حساب رانندگان</a>
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="submitForm(this, true, false)">قابل پرداخت</a>
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="submitForm(this, false, false)">جمع عملکرد</a>
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="submitForm(this, false, true)">جمع عملکرد موردی</a>
            <button class="uk-button uk-button-danger uk-modal-close uk-margin-small-top" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="full-activity-list-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">خروجی بر اساس تقویم کاری</h2>
        </div>
        <div class="uk-modal-body">
            <form method="post" action="@Url.Action("FullActivityList", "Excel")" autocomplete="off">
                <input type="hidden" name="customerId" value="" />
                <input type="hidden" name="type" value="" />
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">تاریخ</label>
                        <select name="calendarId">
                            @foreach (var item in calendars)
                            {
                                <!option value="@item.Id" @if (latestCal.Id.Equals(item)) {
                            <text> selected="selected" </text>
                            }>@item.Title</!option>
                            }
                        </select>
                    </div>
                    <div id="modal-append"></div>
                </div>

            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="submitFullActivity(1)">کامل</a>
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="submitFullActivity(0)">کامل بدون موردی</a>
            <button class="uk-button uk-button-danger uk-modal-close uk-margin-small-top" type="button">بازگشت</button>
        </div>
    </div>
</div>
<div id="contract-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">خروجی مالی بر اساس قرارداد</h2>
        </div>
        <div class="uk-modal-body">
            <form method="get" action="@Url.Action("CustomerBalance", "Report")" autocomplete="off">
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">قرارداد</label>
                        <select name="contractId">
                        </select>
                    </div>
                    <div id="modal-append"></div>
                </div>

            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary uk-margin-small-left uk-margin-small-top" onclick="$('#contract-modal form').submit()">مشاهده</a>
            <button class="uk-button uk-button-danger uk-modal-close uk-margin-small-top" type="button">بازگشت</button>
