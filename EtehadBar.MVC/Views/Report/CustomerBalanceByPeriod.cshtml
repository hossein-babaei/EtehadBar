@model CustomerBalanceVM

@{
    ViewData["pageId"] = 14;
    ViewData["Title"] = $"گزارش مالی {Model.Customer.Name} به تاریخ {new PersianDateTime(DateTime.Now).ToString("yyyy/MM/dd")}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int days = 45;
    if (Model.Customer.CustomerType == CustomerType.SaipaPlasco)
        days = 60;

    string percent = "5";
    double percentMultiple = 0.05;
    if (Model.Customer.CustomerType == CustomerType.SazehGostar)
    {
        percent = "7.8";
        percentMultiple = 0.078;
    }

    var addons = (List<CustomerPeriodicBalanceAddon>)ViewData["CustomerPeriodicBalanceAddon"];
    var addonsSum = addons.Where(a => a.IsPositive).Sum(a => a.Amount) - addons.Where(a => !a.IsPositive).Sum(a => a.Amount);
    var balanceAmount = (double)ViewData["BalanceAmount"];
    var insuranceBalanceAmount = (double)ViewData["InsuranceBalanceAmount"];
    var calendars = (List<Calendar>)ViewData["Calendars"];
}

@section Links {
    <link href="~/css/report-print.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .amount-container {
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 10px
        }

        .underline {
            text-decoration: underline;
        }

        .uk-accordion-content table {
            border: 1px solid #e5e5e5;
            border-radius: 5px !important
        }

        .uk-accordion li {
            padding-bottom: 20px;
            border-bottom: 1px solid #ccc;
        }

            .uk-accordion li:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }
    </style>
}

@section Scripts {
    <script>
        function submitSearch() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CustomerBalance", "Report")',
                data: $('#search-modal form').serialize(),
                dataType: 'html',
                beforeSend: function () {
                    preloader();
                },
                success: function (r) {
                    $('#append').html(r);
                    UIkit.modal('#search-modal').hide();
                },
                error: function (e) {
                    uiAlert(e.responseText, 'danger');
                },
                complete: function () {
                    preloader();
                }
            });
        }
    </script>
}

<div id="append">
    <div class="uk-grid-collapse uk-child-width-1-1@s uk-margin-bottom" uk-grid>
        <div class="uk-width-auto@m">
            <ul class="uk-breadcrumb">
                <li><a asp-action="Index" asp-controller="Admin">داشبورد</a></li>
                <li><a asp-action="Customer" asp-controller="Report">گزارش بر اساس مشتری</a></li>
                <li><span>گزارش مالی @Model.Customer.Name</span></li>
            </ul>
        </div>
        <div class="uk-width-expand@m uk-flex uk-flex-left">
            <a class="uk-button uk-button-primary" href="#search-modal" uk-toggle uk-icon="search"></a>
        </div>
    </div>
    <div class="box uk-margin-small-bottom" style="padding:15px 30px">
        <h3 class="uk-text-center uk-margin-remove">@ViewData["Title"]</h3>
    </div>

    <div class="uk-grid-small uk-child-width-1-1" uk-grid>
        @foreach (var item in Model.Details)
        {
            <div>
                <div class="box">
                    <h4 class="uk-heading-line uk-text-center">
                        <span>@Model.Calendars.Single(a => a.Id.Equals(item.CalendarId)).Title</span>
                    </h4>
                    <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-flex-middle" uk-grid>
                        <div class="uk-width-1-2@s">
                            @if (item.CustomerIncomes.Any())
                            {
                                int i = 1;
                                <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                                    <caption>جدول دریافتی</caption>
                                    <thead>
                                        <tr>
                                            <th width="50">ردیف</th>
                                            <th>تاریخ</th>
                                            <th>شعبه</th>
                                            <th>مبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ci in item.CustomerIncomes)
                                        {
                                            var pd = new PersianDateTime(ci.Date);
                                            <tr class="uk-text-center sm">
                                                <td>@i</td>
                                                <td>@pd.ToString("yyyy/MM/dd")</td>
                                                <td>@ci.BankName</td>
                                                <td>@ci.Amount.ToString("N0")</td>
                                            </tr>
                                            i++;
                                        }
                                        @*<tr class="uk-text-center sm">
                                            <td colspan="3">جمع</td>
                                            <td>@item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</td>
                                        </tr>*@
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="uk-grid-medium uk-text-center uk-child-width-1-1 uk-margin-small-bottom" uk-grid>
                                    <div><i class="fas fa-3x fa-exclamation-triangle uk-text-danger"></i></div>
                                    <div>
                                        <h4>دریافتی وجود ندارد.</h4>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="uk-width-1-2@s">
                            @if (item.CustomerFactors.Any())
                            {
                                int i = 1;
                                <table class="uk-table uk-table-hover uk-table-divider uk-table-small uk-table-middle">
                                    <caption>جدول فاکتور ها</caption>
                                    <thead>
                                        <tr>
                                            <th width="50">ردیف</th>
                                            <th>تاریخ</th>
                                            <th>شماره فاکتور</th>
                                            <th>مبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cf in item.CustomerFactors)
                                        {
                                            var pd = new PersianDateTime(cf.Date);
                                            <tr class="uk-text-center sm">
                                                <td>@i</td>
                                                <td>@pd.ToString("yyyy/MM/dd")</td>
                                                <td>@cf.FactorNumber</td>
                                                <td>@cf.Amount.ToString("N0")</td>
                                            </tr>
                                            i++;
                                        }
                                        @*<tr class="uk-text-center sm">
                                            <td colspan="3">جمع</td>
                                            <td>@item.CustomerFactors.Sum(a => a.Amount).ToString("N0") ریال</td>
                                        </tr>*@
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="uk-grid-medium uk-text-center uk-child-width-1-1 uk-margin-small-bottom" uk-grid>
                                    <div><i class="fas fa-3x fa-exclamation-triangle uk-text-danger"></i></div>
                                    <div>
                                        <h4>فاکتوری ارائه نشده است.</h4>
                                    </div>
                                </div>
                            }
                        </div>
                        <div><hr /></div>
                        <div>
                            <div class="uk-grid-small uk-grid-divider uk-child-width-1-1 uk-child-width-1-2@s uk-text-center" uk-grid>
                                <div>
                                    <b>جمع دریافتی: @item.CustomerIncomes.Sum(a => a.Amount).ToString("N0") ریال</b>
                                </div>
                                <div>
                                    <b>جمع فاکتور: @item.CustomerFactors.Sum(a => a.Amount).ToString("N0") ریال</b>
                                </div>
                                <div></div>
                                <div>
                                    <b>جمع فاکتور با کسر @percent%: @((item.CustomerFactors.Sum(a => a.Amount) - item.CustomerFactors.Sum(a => a.Amount) * percentMultiple).ToString("N0")) ریال</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div>
            <div class="box" style="padding:15px 30px">
                <h3 class="uk-text-center">خلاصه گزارش مالی @Model.Customer.Name در <span class="underline uk-text-left" dir="ltr">@(new PersianDateTime(DateTime.Now).ToString("yyyy/MM/dd"))</span></h3>
                <hr />
                <div class="uk-grid-small uk-child-width-1-1" uk-grid>
                    <div class="amount-container">
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده سال قبل</div>
                            <div><span dir="ltr">@balanceAmount.ToString("N0")</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده سپرده بیمه سال قبل</div>
                            <div><span dir="ltr">@insuranceBalanceAmount.ToString("N0")</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل کارکرد مانده و سپرده بیمه سال قبل</div>
                            <div><span dir="ltr">@((balanceAmount + insuranceBalanceAmount).ToString("N0"))</span> ریال</div>
                        </div>
                    </div>
                    <div class="amount-container">
                        @{
                            var factorsAmount = Model.Details.Sum(a => a.CustomerFactors.Sum(a => a.Amount));
                        }
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل مبلغ فاکتور های ارسالی سال جاری تاکنون (صفر روزه)</div>
                            <div><span dir="ltr">@(factorsAmount.ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">کسر @percent% سپرده بیمه  (صفر روزه)</div>
                            <div><span dir="ltr">@((factorsAmount * percentMultiple).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل پس از کسر @percent% سپرده بیمه  (صفر روزه)</div>
                            <div><span dir="ltr">@((factorsAmount - (factorsAmount * percentMultiple)).ToString("N0"))</span> ریال</div>
                        </div>
                        @* <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر دریافتی ها و مانده سال قبل در سال جاری تاکنون (صفر روزه)</div>
                            <div><span dir="ltr">@(((factorsAmount + balanceAmount + insuranceBalanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر @percent% سپرده بیمه (صفر روزه)</div>
                            <div><span dir="ltr">@((((factorsAmount - factorsAmount * percentMultiple) + balanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div> *@
                    </div>
                    @{
                        var daysSum = Model.Details.Sum(a => a.CustomerFactors.Where(a => a.Date <= DateTime.Now.AddDays(-days)).Sum(a => a.Amount));
                    }
                    <div class="amount-container">
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل مبلغ فاکتور های ارسالی سال جاری تا @days قبل (@days روزه)</div>
                            <div><span dir="ltr">@daysSum.ToString("N0")</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">کسر @percent% سپرده بیمه  (@days روزه)</div>
                            <div><span dir="ltr">@((daysSum * percentMultiple).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل پس از کسر @percent% سپرده بیمه  (@days روزه)</div>
                            <div><span dir="ltr">@((daysSum - (daysSum * percentMultiple)).ToString("N0"))</span> ریال</div>
                        </div>
                        @* <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر دریافتی ها و مانده سال قبل در سال جاری تاکنون (@days روزه)</div>
                            <div><span dir="ltr">@(((daysSum + balanceAmount + insuranceBalanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر @percent% سپرده بیمه (@days روزه)</div>
                            <div><span dir="ltr">@((((daysSum - daysSum * percentMultiple) + balanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div> *@
                    </div>

                    <div class="amount-container">
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل مبلغ دریافتی از ابتدای سال جاری</div>
                            <div><span dir="ltr">@Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount)).ToString("N0")</span> ریال</div>
                        </div>
                        @if (addons.Any())
                        {
                            <div class="uk-grid-small" uk-grid>
                                <div class="uk-width-expand" uk-leader="fill: .">جمع کل کسر/اضافه دوره</div>
                                <div><span dir="ltr">@(addonsSum.ToString("N0"))</span> ریال</div>
                            </div>
                        }
                    </div>

                    <div class="amount-container">
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">جمع کل سپرده بیمه سال قبل و سال جاری</div>
                            <div><span dir="ltr">@((insuranceBalanceAmount + factorsAmount * percentMultiple).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر دریافتی ها و جمع مانده سال قبل در سال جاری تاکنون (صفر روزه)</div>
                            <div><span dir="ltr">@((((factorsAmount - factorsAmount * percentMultiple) + balanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div>
                        <div class="uk-grid-small" uk-grid>
                            <div class="uk-width-expand" uk-leader="fill: .">مانده حساب پس از کسر دریافتی ها و جمع مانده سال قبل در سال جاری تاکنون (@days روزه)</div>
                            <div><span dir="ltr">@(((daysSum - (daysSum * percentMultiple) + balanceAmount) + addonsSum - Model.Details.Sum(a => a.CustomerIncomes.Sum(a => a.Amount))).ToString("N0"))</span> ریال</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="search-modal" uk-modal>
    <div class="uk-modal-dialog">
        <div class="uk-modal-header uk-light">
            <h2 class="uk-modal-title">فیلتر نتایج</h2>
        </div>
        <div class="uk-modal-body">
            <form method="post" action="@Url.Action("CustomerBalance", "Report")" autocomplete="off">
                <input type="hidden" name="customerId" value="@Model.Customer.Id" />
                <div class="uk-grid-medium uk-child-width-1-1" data-uk-grid>
                    <div>
                        <label class="uk-form-label">از</label>
                        <select class="uk-select uk-border-rounded uk-form-small" name="fromCalendarId">
                            @foreach (var item in calendars)
                            {
                                <option value="@item.Id">@item.Title</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="uk-form-label">تا</label>
                        <select class="uk-select uk-border-rounded uk-form-small" name="toCalendarId">
                            @foreach (var item in calendars)
                            {
                                <option value="@item.Id">@item.Title</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
        <div class="uk-modal-footer uk-text-center">
            <a class="uk-button uk-button-primary uk-margin-small-left" onclick="submitSearch()">مشاهده</a>
            <button class="uk-button uk-button-danger uk-modal-close" type="button">بازگشت</button>
        </div>
    </div>
</div>